                        </Grid>

                        <Border Padding="10,6" CornerRadius="6" Background="{StaticResource PanelRaisedBrush}">
                            <StackPanel>
                                <TextBlock Text="RF INPUT" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <TextBlock x:Name="RfSummaryPowerText" Text="— dBFS" Style="{StaticResource KpiValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Padding="10,6" CornerRadius="6" Background="{StaticResource PanelRaisedBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="MER" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    <TextBlock x:Name="MerValueText" Text="— dB" Style="{StaticResource KpiValueStyle}" />
                                </StackPanel>
                                <FontIcon Grid.Column="1" Glyph="&#xE9D2;" Foreground="{StaticResource MeasurementAccentBrush}" />
                            </Grid>
                        </Border>
                        <Border Padding="10,6" CornerRadius="6" Background="{StaticResource PanelRaisedBrush}">
