                                            <NumberBox x:Name="RfSpectrumCenterNumberBox"
                                                       Header="CENTER (MHz)"
                                                       Width="126"
                                                       Minimum="100"
                                                       Maximum="300"
                                                       SmallChange="0.001"
                                                       Value="213.360"
                                                       SpinButtonPlacementMode="Compact"
                                                       ValueChanged="RfSpectrumCenter_ValueChanged" />
                                            <ComboBox x:Name="RfSpectrumSpanComboBox"
                                                      Header="SPAN"
                                                      Width="114"
                                                      SelectedIndex="0"
                                                      SelectionChanged="RfSpectrumControls_SelectionChanged">
                                                <ComboBoxItem Content="2.048 MHz" Tag="2048000" />
                                                <ComboBoxItem Content="1.000 MHz" Tag="1000000" />
                                                <ComboBoxItem Content="500 kHz" Tag="500000" />
                                                <ComboBoxItem Content="200 kHz" Tag="200000" />
                                                <ComboBoxItem Content="100 kHz" Tag="100000" />
                                                <ComboBoxItem x:Name="RfSpectrumCustomSpanItem" Content="Custom" Tag="0" IsEnabled="False" />
                                            </ComboBox>
                                            <ComboBox x:Name="RfSpectrumFftComboBox"
