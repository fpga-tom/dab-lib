                                        <StackPanel Spacing="5">
                                            <TextBlock Text="AUDIO AVAILABILITY" Style="{StaticResource RfMetricLabelStyle}" />
                                            <TextBlock x:Name="DabOverviewAudioAvailabilityValueText" Text="—" Style="{StaticResource RfMetricValueStyle}" />
                                            <TextBlock x:Name="DabOverviewAudioAvailabilityDetailText" Text="Awaiting DAB+ superframes" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                            <TextBlock Text="Open DAB+  →" Foreground="{StaticResource SpectrumBrush}" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <Button Grid.Row="1" Grid.Column="0" Tag="fic:fig" Click="DabOverviewKpi_Click"
                                        Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                    <Border Style="{StaticResource RfMetricCardStyle}">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="FIG PARSING" Style="{StaticResource RfMetricLabelStyle}" />
                                            <TextBlock x:Name="DabOverviewFigValueText" Text="—" FontSize="22" FontWeight="SemiBold" FontFamily="Consolas" />
                                            <TextBlock x:Name="DabOverviewFigDetailText" Text="Awaiting FIC" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                </Button>
                                <Button Grid.Row="1" Grid.Column="1" Tag="msc:service" Click="DabOverviewKpi_Click"
                                        Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                    <Border Style="{StaticResource RfMetricCardStyle}">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="SELECTED SERVICE" Style="{StaticResource RfMetricLabelStyle}" />
                                            <TextBlock x:Name="DabOverviewServiceValueText" Text="—" FontSize="22" FontWeight="SemiBold" FontFamily="Consolas" />
                                            <TextBlock x:Name="DabOverviewServiceDetailText" Text="No service selected" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                </Button>
                                <Button Grid.Row="1" Grid.Column="2" Tag="dab:crc" Click="DabOverviewKpi_Click"
                                        Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                    <Border Style="{StaticResource RfMetricCardStyle}">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="AUDIO CRC" Style="{StaticResource RfMetricLabelStyle}" />
                                            <TextBlock x:Name="DabOverviewAudioCrcValueText" Text="—" FontSize="22" FontWeight="SemiBold" FontFamily="Consolas" />
                                            <TextBlock x:Name="DabOverviewAudioCrcDetailText" Text="Awaiting audio units" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                </Button>
                                <Button Grid.Row="1" Grid.Column="3" Tag="fic:reconfiguration" Click="DabOverviewKpi_Click"
                                        Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                    <Border Style="{StaticResource RfMetricCardStyle}">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="RECONFIGURATION" Style="{StaticResource RfMetricLabelStyle}" />
                                            <TextBlock x:Name="DabOverviewReconfigValueText" Text="NONE PENDING" FontSize="20" FontWeight="SemiBold" FontFamily="Consolas" />
                                            <TextBlock x:Name="DabOverviewReconfigDetailText" Text="Awaiting database" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </Grid>

                            <Border Style="{StaticResource PanelCardStyle}" Padding="16,12">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <TextBlock Text="QUALITY TIMELINE — LAST 60 SECONDS" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock x:Name="DabOverviewMuteMarkerText"
                                                   Text="No audio interruptions"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11" />
                                    </Grid>
                                    <Viewbox Stretch="Fill" Height="168">
                                        <Canvas Width="900" Height="150">
                                            <TextBlock Text="FIC CRC" Canvas.Left="0" Canvas.Top="10" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                            <TextBlock Text="MSC BER" Canvas.Left="0" Canvas.Top="43" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                            <TextBlock Text="RS bytes" Canvas.Left="0" Canvas.Top="76" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                            <TextBlock Text="Audio" Canvas.Left="0" Canvas.Top="109" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                            <Line X1="70" Y1="28" X2="895" Y2="28" Stroke="#253D556E" />
                                            <Line X1="70" Y1="61" X2="895" Y2="61" Stroke="#253D556E" />
                                            <Line X1="70" Y1="94" X2="895" Y2="94" Stroke="#253D556E" />
                                            <Line X1="70" Y1="127" X2="895" Y2="127" Stroke="#253D556E" />
                                            <Polyline x:Name="DabOverviewFicTimelineTrace" Stroke="{StaticResource MeasurementAccentBrush}" StrokeThickness="2" />
                                            <Polyline x:Name="DabOverviewMscTimelineTrace" Stroke="{StaticResource SpectrumBrush}" StrokeThickness="2" />
                                            <Polyline x:Name="DabOverviewRsTimelineTrace" Stroke="{StaticResource WarningBrush}" StrokeThickness="2" />
                                            <Polyline x:Name="DabOverviewAudioTimelineTrace" Stroke="#FF78E08F" StrokeThickness="5" />
                                        </Canvas>
                                    </Viewbox>
                                </StackPanel>
                            </Border>

                            <!-- Retained hidden bindings preserve compatibility with the earlier
                                 overview while the pipeline dashboard becomes the visible page. -->
                            <Grid ColumnSpacing="10" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource RfMetricCardStyle}" MinHeight="132">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="FIC QUALITY" Style="{StaticResource RfMetricLabelStyle}" />
                                        <TextBlock x:Name="DabOverviewFicValueText" Text="—" Style="{StaticResource RfMetricValueStyle}" />
                                        <TextBlock x:Name="DabOverviewFicDetailText"
                                                   Text="Awaiting decoded FIBs"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource RfMetricCardStyle}" MinHeight="132">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="MSC" Style="{StaticResource RfMetricLabelStyle}" />
                                        <TextBlock x:Name="DabOverviewMscValueText" Text="IDLE" Style="{StaticResource RfMetricValueStyle}" />
                                        <TextBlock x:Name="DabOverviewMscDetailText"
                                                   Text="Awaiting MSC frames"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource RfMetricCardStyle}" MinHeight="132">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="DAB+ AUDIO" Style="{StaticResource RfMetricLabelStyle}" />
                                        <TextBlock x:Name="DabOverviewDabValueText" Text="IDLE" Style="{StaticResource RfMetricValueStyle}" />
                                        <TextBlock x:Name="DabOverviewDabDetailText"
                                                   Text="No audio superframe"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Style="{StaticResource RfMetricCardStyle}" MinHeight="132">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="FRAME STATUS" Style="{StaticResource RfMetricLabelStyle}" />
                                        <TextBlock x:Name="DabOverviewStatusValueText" Text="IDLE" Style="{StaticResource RfMetricValueStyle}" />
                                        <TextBlock x:Name="DabOverviewStatusDetailText"
                                                   Text="Receiver stopped"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid ColumnSpacing="10" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource PanelCardStyle}" Padding="16">
                                    <StackPanel Spacing="9">
                                        <TextBlock Text="Selected programme" FontSize="16" FontWeight="SemiBold" />
                                        <Grid ColumnSpacing="12" RowSpacing="7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Ensemble" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Column="1" x:Name="DabOverviewEnsembleText" Text="Awaiting FIC" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="1" Text="Service" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DabOverviewServiceText" Text="Not selected" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="2" Text="Component" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DabOverviewComponentText" Text="Awaiting component" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="3" Text="Service ID" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DabOverviewServiceIdText" Text="—" FontFamily="Consolas" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Padding="16">
                                    <StackPanel Spacing="9">
                                        <TextBlock Text="Latest decoder activity" FontSize="16" FontWeight="SemiBold" />
                                        <Grid ColumnSpacing="12" RowSpacing="7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="FIC frames" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Column="1" x:Name="DabOverviewFicFramesText" Text="0" FontFamily="Consolas" />
