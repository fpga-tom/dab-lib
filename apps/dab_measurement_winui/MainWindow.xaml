                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Grid.Row="3" x:Name="RfPowerDetailText" Text="ADC-referenced · calibration required" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource RfMetricCardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="C/N" Style="{StaticResource RfMetricLabelStyle}" />
                                        <TextBlock Grid.Row="1" x:Name="RfCnValueText" Text="— dB" Style="{StaticResource RfMetricValueStyle}" />
                                        <Viewbox Grid.Row="2" Stretch="Fill" Margin="0,3">
                                            <Canvas Width="100" Height="24">
                                                <Line X1="0" Y1="20" X2="100" Y2="20" Stroke="#253D556E" />
                                                <Polyline x:Name="RfCnSparkline" Stroke="{StaticResource MeasurementAccentBrush}" StrokeThickness="1.5" Points="0,20 100,20" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Grid.Row="3" Text="Null-symbol estimate" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource RfMetricCardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="MER" Style="{StaticResource RfMetricLabelStyle}" />
                                        <TextBlock Grid.Row="1" x:Name="RfMerValueText" Text="— dB" Style="{StaticResource RfMetricValueStyle}" />
                                        <Viewbox Grid.Row="2" Stretch="Fill" Margin="0,3">
                                            <Canvas Width="100" Height="24">
                                                <Line X1="0" Y1="20" X2="100" Y2="20" Stroke="#253D556E" />
                                                <Polyline x:Name="RfMerSparkline" Stroke="{StaticResource WarningBrush}" StrokeThickness="1.5" Points="0,20 100,20" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Grid.Row="3" Text="Average over active carriers" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource RfMetricCardStyle}">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="STATUS" Style="{StaticResource RfMetricLabelStyle}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Ellipse x:Name="RfLockIndicator" Width="10" Height="10" Fill="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="RfStatusValueText" Text="IDLE" FontFamily="Consolas" FontSize="24" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock x:Name="RfStatusDetailText" Text="Receiver stopped" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource RfMetricCardStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="CFO" Style="{StaticResource RfMetricLabelStyle}" />
                                        <TextBlock x:Name="RfCfoValueText" Text="— Hz" Style="{StaticResource RfMetricValueStyle}" />
                                        <TextBlock x:Name="RfResidualCfoText" Text="Residual — Hz" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource RfMetricCardStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="SAMPLE CLOCK" Style="{StaticResource RfMetricLabelStyle}" />
                                        <TextBlock x:Name="RfSampleClockValueText" Text="— ppm" Style="{StaticResource RfMetricValueStyle}" />
                                        <TextBlock x:Name="RfSampleClockDetailText" Text="Estimator not available" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource RfMetricCardStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="ADC LEVEL" Style="{StaticResource RfMetricLabelStyle}" />
                                        <TextBlock x:Name="RfAdcValueText" Text="— dBFS" Style="{StaticResource RfMetricValueStyle}" />
                                        <TextBlock x:Name="RfClippingText" Text="Clipping measurement unavailable" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource RfMetricCardStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="OVERRUNS" Style="{StaticResource RfMetricLabelStyle}" />
                                        <TextBlock x:Name="RfOverrunValueText" Text="0" Style="{StaticResource RfMetricValueStyle}" />
                                        <TextBlock Text="Since receiver start" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource PanelCardStyle}" Padding="16">
                                    <Grid RowSpacing="7">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="RF quality — last 60 seconds" FontSize="15" FontWeight="SemiBold" />
                                        <Grid Grid.Row="1" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Power" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                            <Viewbox Grid.Column="1" Height="45" Stretch="Fill">
                                                <Canvas Width="520" Height="45" Background="#FF07101B">
                                                    <Line X1="0" Y1="38" X2="520" Y2="38" Stroke="#253D556E" />
                                                    <Polyline x:Name="RfPowerHistoryTrace" Stroke="{StaticResource SpectrumBrush}" StrokeThickness="2" Points="0,38 520,38" />
                                                </Canvas>
                                            </Viewbox>
                                        </Grid>
                                        <Grid Grid.Row="2" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="MER" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                            <Viewbox Grid.Column="1" Height="45" Stretch="Fill">
                                                <Canvas Width="520" Height="45" Background="#FF07101B">
                                                    <Line X1="0" Y1="38" X2="520" Y2="38" Stroke="#253D556E" />
                                                    <Polyline x:Name="RfMerHistoryTrace" Stroke="{StaticResource WarningBrush}" StrokeThickness="2" Points="0,38 520,38" />
                                                </Canvas>
                                            </Viewbox>
                                        </Grid>
                                        <Grid Grid.Row="3" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="C/N" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                            <Viewbox Grid.Column="1" Height="45" Stretch="Fill">
                                                <Canvas Width="520" Height="45" Background="#FF07101B">
                                                    <Line X1="0" Y1="38" X2="520" Y2="38" Stroke="#253D556E" />
                                                    <Polyline x:Name="RfCnHistoryTrace" Stroke="{StaticResource MeasurementAccentBrush}" StrokeThickness="2" Points="0,38 520,38" />
                                                </Canvas>
                                            </Viewbox>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Padding="16">
                                    <Grid RowSpacing="9" ColumnSpacing="14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.ColumnSpan="2" Text="Current receiver configuration" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,3" />
                                        <TextBlock Grid.Row="1" Text="Device gain" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RfConfigGainText" Text="40 dB" FontFamily="Consolas" />
                                        <TextBlock Grid.Row="2" Text="AGC" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="RfConfigAgcText" Text="Disabled" FontFamily="Consolas" />
                                        <TextBlock Grid.Row="3" Text="Sample rate" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="RfConfigSampleRateText" Text="2.048 MS/s" FontFamily="Consolas" />
                                        <TextBlock Grid.Row="4" Text="Antenna port" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="RfConfigAntennaText" Text="A" FontFamily="Consolas" />
                                        <TextBlock Grid.Row="5" Text="Calibration" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="RfConfigCalibrationText" Text="Not configured" Foreground="{StaticResource WarningBrush}" FontFamily="Consolas" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource PanelCardStyle}" Padding="16,12">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Active warnings" FontSize="15" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7BA;" Foreground="{StaticResource WarningBrush}" FontSize="13" />
                                        <TextBlock x:Name="RfWarningsText"
                                                   Text="Input power is ADC-referenced (dBFS) until an RF calibration profile is configured."
                                                   Foreground="{StaticResource WarningBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>
                <TabViewItem Header="Spectrum" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="12">
                        <StackPanel x:Name="RfSpectrumCaptureRoot"
                                    Spacing="10"
                                    Loaded="RfSpectrum_Loaded">
                            <Border Style="{StaticResource PanelCardStyle}" Padding="14,10">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="Spectrum controls" FontSize="15" FontWeight="SemiBold" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <StackPanel Orientation="Horizontal" Spacing="10" MinWidth="1040">
                                            <NumberBox x:Name="RfSpectrumCenterNumberBox"
                                                       Header="CENTER (MHz)"
                                                       Width="126"
                                                       Minimum="100"
                                                       Maximum="300"
                                                       SmallChange="0.001"
                                                       Value="213.360"
                                                       SpinButtonPlacementMode="Compact"
                                                       ValueChanged="RfSpectrumCenter_ValueChanged" />
                                            <ComboBox x:Name="RfSpectrumSpanComboBox"
                                                      Header="SPAN"
                                                      Width="114"
                                                      SelectedIndex="0"
                                                      SelectionChanged="RfSpectrumControls_SelectionChanged">
                                                <ComboBoxItem Content="2.048 MHz" Tag="2048000" />
                                                <ComboBoxItem Content="1.000 MHz" Tag="1000000" />
                                                <ComboBoxItem Content="500 kHz" Tag="500000" />
                                                <ComboBoxItem Content="200 kHz" Tag="200000" />
                                                <ComboBoxItem Content="100 kHz" Tag="100000" />
                                                <ComboBoxItem x:Name="RfSpectrumCustomSpanItem" Content="Custom" Tag="0" IsEnabled="False" />
                                            </ComboBox>
                                            <ComboBox x:Name="RfSpectrumFftComboBox"
                                                      Header="FFT SIZE"
                                                      Width="92"
                                                      SelectedIndex="0"
                                                      IsEnabled="False"
                                                      ToolTipService.ToolTip="The receiver measurement stream supplies a native 2048-bin FFT">
                                                <ComboBoxItem Content="2048" />
                                            </ComboBox>
                                            <StackPanel Width="104">
                                                <TextBlock Text="RBW" Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock x:Name="RfSpectrumRbwText"
                                                           Text="1.000 kHz"
                                                           FontFamily="Consolas"
                                                           Margin="0,9,0,0" />
                                            </StackPanel>
                                            <ComboBox x:Name="RfSpectrumWindowComboBox"
                                                      Header="WINDOW"
                                                      Width="132"
                                                      SelectedIndex="0"
                                                      IsEnabled="False"
                                                      ToolTipService.ToolTip="Bins are supplied directly by the synchronized receiver FFT; no additional display window is applied">
                                                <ComboBoxItem Content="Receiver FFT" />
                                            </ComboBox>
                                            <ComboBox x:Name="RfSpectrumAverageComboBox"
                                                      Header="AVERAGING"
                                                      Width="90"
                                                      SelectedIndex="3"
                                                      SelectionChanged="RfSpectrumControls_SelectionChanged">
                                                <ComboBoxItem Content="1" Tag="1" />
                                                <ComboBoxItem Content="2" Tag="2" />
                                                <ComboBoxItem Content="4" Tag="4" />
                                                <ComboBoxItem Content="8" Tag="8" />
                                                <ComboBoxItem Content="16" Tag="16" />
                                                <ComboBoxItem Content="32" Tag="32" />
                                            </ComboBox>
                                            <NumberBox x:Name="RfSpectrumReferenceNumberBox"
                                                       Header="REFERENCE"
                                                       Width="104"
                                                       Minimum="-80"
                                                       Maximum="10"
                                                       SmallChange="5"
                                                       Value="-20"
                                                       SpinButtonPlacementMode="Compact"
                                                       ValueChanged="RfSpectrumReference_ValueChanged" />
                                            <ComboBox x:Name="RfSpectrumScaleComboBox"
                                                      Header="SCALE"
                                                      Width="96"
                                                      SelectedIndex="1"
                                                      SelectionChanged="RfSpectrumControls_SelectionChanged">
                                                <ComboBoxItem Content="5 dB/div" Tag="5" />
                                                <ComboBoxItem Content="10 dB/div" Tag="10" />
                                                <ComboBoxItem Content="20 dB/div" Tag="20" />
                                            </ComboBox>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <StackPanel Orientation="Horizontal" Spacing="8" MinWidth="1040">
                                            <ToggleButton x:Name="RfSpectrumMarker1Button"
                                                          Content="Marker 1"
                                                          IsChecked="True"
                                                          Click="RfSpectrumMarker_Click" />
                                            <ToggleButton x:Name="RfSpectrumMarker2Button"
                                                          Content="Marker 2"
                                                          Click="RfSpectrumMarker_Click" />
                                            <ToggleButton x:Name="RfSpectrumPeakHoldButton"
                                                          Content="Peak hold"
                                                          IsChecked="True"
                                                          Click="RfSpectrumPeakHold_Click" />
                                            <Button Content="Clear peaks" Click="RfSpectrumClearPeaks_Click" />
                                            <ToggleButton x:Name="RfSpectrumFreezeButton"
                                                          Content="Freeze"
                                                          Click="RfSpectrumFreeze_Click" />
                                            <Button Content="Save screenshot" Click="RfSpectrumSaveScreenshot_Click" />
                                            <ComboBox x:Name="RfSpectrumTriggerComboBox"
                                                      Width="128"
                                                      SelectedIndex="0"
                                                      ToolTipService.ToolTip="Trigger selection for a future raw-IQ recorder">
                                                <ComboBoxItem Content="Manual trigger" />
                                                <ComboBoxItem Content="Level rising" />
                                                <ComboBoxItem Content="Sync loss" />
                                            </ComboBox>
                                            <Button Content="Capture IQ"
                                                    IsEnabled="False"
                                                    ToolTipService.ToolTip="Raw IQ is not exposed by the current receiver pipeline yet" />
                                            <TextBlock x:Name="RfSpectrumInteractionHintText"
                                                       Text="Wheel zoom · drag pan · double-click reset · click/drag marker"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PanelCardStyle}" Padding="12,10">
                                <Grid RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="300" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Spectrum" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1"
                                                   x:Name="RfSpectrumViewText"
                                                   Text="213.360 MHz · 2.048 MHz span"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontFamily="Consolas" />
                                    </Grid>
                                    <Grid Grid.Row="1" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Stretch="Fill">
                                            <Canvas Width="58" Height="300">
                                                <TextBlock x:Name="RfSpectrumYAxisTopText" Text="-20" FontFamily="Consolas" FontSize="11" Width="58" TextAlignment="Right" Canvas.Top="0" />
                                                <TextBlock x:Name="RfSpectrumYAxis1Text" Text="-40" FontFamily="Consolas" FontSize="11" Width="58" TextAlignment="Right" Canvas.Top="92" />
                                                <TextBlock x:Name="RfSpectrumYAxis2Text" Text="-60" FontFamily="Consolas" FontSize="11" Width="58" TextAlignment="Right" Canvas.Top="192" />
                                                <TextBlock x:Name="RfSpectrumYAxisBottomText" Text="-80 dBFS" FontFamily="Consolas" FontSize="11" Width="58" TextAlignment="Right" Canvas.Top="282" />
                                            </Canvas>
                                        </Viewbox>
                                        <Border Grid.Column="1" BorderBrush="{StaticResource PanelStrokeBrush}" BorderThickness="1" Background="#FF07101B">
                                            <Viewbox Stretch="Fill">
                                                <Canvas x:Name="RfSpectrumCanvas"
                                                        Width="1000"
                                                        Height="300"
                                                        Background="#FF07101B"
                                                        PointerWheelChanged="RfSpectrumCanvas_PointerWheelChanged"
                                                        PointerPressed="RfSpectrumCanvas_PointerPressed"
                                                        PointerMoved="RfSpectrumCanvas_PointerMoved"
                                                        PointerReleased="RfSpectrumCanvas_PointerReleased"
                                                        PointerExited="RfSpectrumCanvas_PointerExited"
                                                        PointerCaptureLost="RfSpectrumCanvas_PointerCaptureLost"
                                                        DoubleTapped="RfSpectrumCanvas_DoubleTapped">
                                                    <Canvas.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="Tune receiver to selected frequency" Click="RfSpectrumTuneToCursor_Click" />
                                                            <MenuFlyoutItem Text="Reset spectrum view" Click="RfSpectrumResetView_Click" />
                                                        </MenuFlyout>
                                                    </Canvas.ContextFlyout>
                                                    <Line X1="0" Y1="50" X2="1000" Y2="50" Stroke="#253D556E" StrokeThickness="1" />
                                                    <Line X1="0" Y1="100" X2="1000" Y2="100" Stroke="#253D556E" StrokeThickness="1" />
                                                    <Line X1="0" Y1="150" X2="1000" Y2="150" Stroke="#253D556E" StrokeThickness="1" />
                                                    <Line X1="0" Y1="200" X2="1000" Y2="200" Stroke="#253D556E" StrokeThickness="1" />
                                                    <Line X1="0" Y1="250" X2="1000" Y2="250" Stroke="#253D556E" StrokeThickness="1" />
                                                    <Line X1="250" Y1="0" X2="250" Y2="300" Stroke="#183D556E" StrokeThickness="1" />
                                                    <Line X1="500" Y1="0" X2="500" Y2="300" Stroke="#253D556E" StrokeThickness="1" />
                                                    <Line X1="750" Y1="0" X2="750" Y2="300" Stroke="#183D556E" StrokeThickness="1" />
                                                    <Polyline x:Name="RfSpectrumPeakTrace"
                                                              Stroke="#66FFC857"
                                                              StrokeThickness="1"
                                                              Points="0,300 1000,300" />
                                                    <Polyline x:Name="RfSpectrumLiveTrace"
                                                              Stroke="{StaticResource SpectrumBrush}"
                                                              StrokeThickness="2"
                                                              Points="0,300 1000,300" />
                                                    <Line x:Name="RfSpectrumMarker1Line" X1="0" Y1="0" X2="0" Y2="300" Stroke="#FFFFC857" StrokeThickness="1.5" Visibility="Collapsed" />
                                                    <Line x:Name="RfSpectrumMarker2Line" X1="0" Y1="0" X2="0" Y2="300" Stroke="#FFFF6B9A" StrokeThickness="1.5" Visibility="Collapsed" />
                                                    <Border x:Name="RfSpectrumTooltipBorder"
                                                            Canvas.Left="0"
                                                            Canvas.Top="0"
                                                            Padding="7,4"
                                                            CornerRadius="4"
                                                            Background="#E6233447"
                                                            BorderBrush="#FF5A718A"
                                                            BorderThickness="1"
                                                            Visibility="Collapsed">
                                                        <TextBlock x:Name="RfSpectrumTooltipText" Text="— MHz · — dBFS" FontFamily="Consolas" FontSize="11" />
                                                    </Border>
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                    </Grid>
                                    <Grid Grid.Row="2" Margin="66,0,0,0">
                                        <TextBlock x:Name="RfSpectrumAxisLeftText" Text="212.336 MHz" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Left" />
                                        <TextBlock x:Name="RfSpectrumAxisCenterText" Text="213.360 MHz" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="RfSpectrumAxisRightText" Text="214.384 MHz" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource PanelCardStyle}" Padding="12,10">
                                <Grid RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="150" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Waterfall" FontSize="15" FontWeight="SemiBold" />
                                    <Border Grid.Row="1" BorderBrush="{StaticResource PanelStrokeBrush}" BorderThickness="1" Background="#FF07101B">
                                        <Viewbox Stretch="Fill">
                                            <Canvas x:Name="RfSpectrumWaterfallCanvas" Width="1000" Height="150" Background="#FF07101B" />
                                        </Viewbox>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource PanelCardStyle}" Padding="12,8">
                                <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="RfSpectrumMarkerStatusText"
                                               Text="Marker 1: click the spectrum to place"
                                               FontFamily="Consolas"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               x:Name="RfSpectrumNoiseFloorText"
                                               Text="Noise floor: — dBFS"
                                               FontFamily="Consolas"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>
                <TabViewItem Header="RF Input" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="12">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource PanelCardStyle}" Padding="16">
                                    <Grid RowSpacing="9" ColumnSpacing="18">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,4">
                                            <TextBlock Text="Input level" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="DC-removed complex power in the latest PRS window"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="RMS" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RfInputRmsText" Text="— dBFS" FontFamily="Consolas" FontSize="15" />
                                        <TextBlock Grid.Row="2" Text="Peak" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="RfInputPeakText" Text="— dBFS" FontFamily="Consolas" FontSize="15" />
