                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="Tune receiver to selected frequency" Click="RfSpectrumTuneToCursor_Click" />
                                                            <MenuFlyoutItem Text="Reset spectrum view" Click="RfSpectrumResetView_Click" />
                                                        </MenuFlyout>
                                                    </Canvas.ContextFlyout>
                                                    <Line X1="0" Y1="50" X2="1000" Y2="50" Stroke="#253D556E" StrokeThickness="1" />
                                                    <Line X1="0" Y1="100" X2="1000" Y2="100" Stroke="#253D556E" StrokeThickness="1" />
                                                    <Line X1="0" Y1="150" X2="1000" Y2="150" Stroke="#253D556E" StrokeThickness="1" />
                                                    <Line X1="0" Y1="200" X2="1000" Y2="200" Stroke="#253D556E" StrokeThickness="1" />
                                                    <Line X1="0" Y1="250" X2="1000" Y2="250" Stroke="#253D556E" StrokeThickness="1" />
                                                    <Line X1="250" Y1="0" X2="250" Y2="300" Stroke="#183D556E" StrokeThickness="1" />
                                                    <Line X1="500" Y1="0" X2="500" Y2="300" Stroke="#253D556E" StrokeThickness="1" />
                                                    <Line X1="750" Y1="0" X2="750" Y2="300" Stroke="#183D556E" StrokeThickness="1" />
                                                    <Polyline x:Name="RfSpectrumPeakTrace"
                                                              Stroke="#66FFC857"
                                                              StrokeThickness="1"
                                                              Points="0,300 1000,300" />
                                                    <Polyline x:Name="RfSpectrumLiveTrace"
                                                              Stroke="{StaticResource SpectrumBrush}"
                                                              StrokeThickness="2"
                                                              Points="0,300 1000,300" />
                                                    <Line x:Name="RfSpectrumMarker1Line" X1="0" Y1="0" X2="0" Y2="300" Stroke="#FFFFC857" StrokeThickness="1.5" Visibility="Collapsed" />
                                                    <Line x:Name="RfSpectrumMarker2Line" X1="0" Y1="0" X2="0" Y2="300" Stroke="#FFFF6B9A" StrokeThickness="1.5" Visibility="Collapsed" />
                                                    <Border x:Name="RfSpectrumTooltipBorder"
                                                            Canvas.Left="0"
                                                            Canvas.Top="0"
