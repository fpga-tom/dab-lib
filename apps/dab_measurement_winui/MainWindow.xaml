                                            <ComboBox x:Name="RfSpectrumWindowComboBox"
                                                      Header="WINDOW"
                                                      Width="132"
                                                      SelectedIndex="0"
                                                      IsEnabled="False"
                                                      ToolTipService.ToolTip="Bins are supplied directly by the synchronized receiver FFT; no additional display window is applied">
                                                <ComboBoxItem Content="Receiver FFT" />
                                            </ComboBox>
                                            <ComboBox x:Name="RfSpectrumAverageComboBox"
                                                      Header="AVERAGING"
                                                      Width="90"
                                                      SelectedIndex="3"
                                                      SelectionChanged="RfSpectrumControls_SelectionChanged">
                                                <ComboBoxItem Content="1" Tag="1" />
                                                <ComboBoxItem Content="2" Tag="2" />
                                                <ComboBoxItem Content="4" Tag="4" />
                                                <ComboBoxItem Content="8" Tag="8" />
                                                <ComboBoxItem Content="16" Tag="16" />
                                                <ComboBoxItem Content="32" Tag="32" />
                                            </ComboBox>
                                            <NumberBox x:Name="RfSpectrumReferenceNumberBox"
