                                            <ColumnDefinition Width="135" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="TIME" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Grid.Column="1" Text="SEVERITY" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Grid.Column="2" Text="MEASUREMENT" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Grid.Column="3" Text="VALUE" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Grid.Column="4" Text="DESCRIPTION" Style="{StaticResource SectionTitleStyle}" />
