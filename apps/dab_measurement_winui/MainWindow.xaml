                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <TabViewItem x:Name="DabFicTab" Header="FIC" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="DabFicFocusText"
                                       Text="Selected metric: FIC CRC"
                                       Foreground="{StaticResource SpectrumBrush}"
                                       FontWeight="SemiBold" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource RfMetricCardStyle}">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="FIC FRAMES" Style="{StaticResource RfMetricLabelStyle}" />
                                        <TextBlock x:Name="DabFicFramesText" Text="0" Style="{StaticResource RfMetricValueStyle}" />
                                        <TextBlock Text="Since receiver start" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource RfMetricCardStyle}">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="LATEST BLOCKS" Style="{StaticResource RfMetricLabelStyle}" />
                                        <TextBlock x:Name="DabFicBlocksText" Text="0" Style="{StaticResource RfMetricValueStyle}" />
                                        <TextBlock Text="Decoded in latest frame" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource RfMetricCardStyle}">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="VALID FIBs" Style="{StaticResource RfMetricLabelStyle}" />
                                        <TextBlock x:Name="DabFicValidText" Text="0 / 12" Style="{StaticResource RfMetricValueStyle}" />
                                        <TextBlock Text="Latest FIC frame" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Style="{StaticResource RfMetricCardStyle}">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="FIB SUCCESS" Style="{StaticResource RfMetricLabelStyle}" />
                                        <TextBlock x:Name="DabFicQualityText" Text="—" Style="{StaticResource RfMetricValueStyle}" />
                                        <TextBlock Text="Aggregate CRC-valid FIBs" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource PanelCardStyle}" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Fast Information Channel catalogue" FontSize="16" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="14" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Ensemble" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Column="1" x:Name="DabFicEnsembleText" Text="Awaiting FIC" />
                                        <TextBlock Grid.Row="1" Text="Ensemble ID" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DabFicEnsembleIdText" Text="—" FontFamily="Consolas" />
                                        <TextBlock Grid.Row="2" Text="Decoded services" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DabFicServicesText" Text="0" FontFamily="Consolas" />
                                        <TextBlock Grid.Row="3" Text="Catalogue generation" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DabFicCatalogSequenceText" Text="—" FontFamily="Consolas" />
                                        <TextBlock Grid.Row="4" Text="Total CRC-valid FIBs" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DabFicTotalText" Text="0" FontFamily="Consolas" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <TabViewItem x:Name="DabMscTab" Header="MSC" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="DabMscFocusText"
                                       Text="Selected metric: MSC BER"
                                       Foreground="{StaticResource SpectrumBrush}"
                                       FontWeight="SemiBold" />
                            <Border Style="{StaticResource PanelCardStyle}" Padding="14">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="POST-VITERBI BER" Style="{StaticResource RfMetricLabelStyle}" />
                                        <TextBlock x:Name="DabMscBerPageValueText" Text="—" Style="{StaticResource RfMetricValueStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               x:Name="DabMscBerPageDetailText"
                                               Text="Awaiting decoded and re-encoded MSC bits"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource RfMetricCardStyle}">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="MSC FRAMES" Style="{StaticResource RfMetricLabelStyle}" />
                                        <TextBlock x:Name="DabMscFramesText" Text="0" Style="{StaticResource RfMetricValueStyle}" />
                                        <TextBlock Text="Since receiver start" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource RfMetricCardStyle}">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="SYNCHRONISATION" Style="{StaticResource RfMetricLabelStyle}" />
                                        <TextBlock x:Name="DabMscSyncText" Text="NO" Style="{StaticResource RfMetricValueStyle}" />
                                        <TextBlock Text="MSC time deinterleaver" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource RfMetricCardStyle}">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="SUPERFRAME" Style="{StaticResource RfMetricLabelStyle}" />
                                        <TextBlock x:Name="DabMscSuperframeText" Text="—" Style="{StaticResource RfMetricValueStyle}" />
                                        <TextBlock Text="Latest DAB+ superframe" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Style="{StaticResource RfMetricCardStyle}">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="AUDIO PAYLOAD" Style="{StaticResource RfMetricLabelStyle}" />
                                        <TextBlock x:Name="DabMscAudioText" Text="—" Style="{StaticResource RfMetricValueStyle}" />
                                        <TextBlock Text="Selected component data" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource PanelCardStyle}" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Selected MSC component" FontSize="16" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="14" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Service" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Column="1" x:Name="DabMscServiceText" Text="Not selected" />
                                        <TextBlock Grid.Row="1" Text="Component" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DabMscComponentText" Text="Awaiting component" />
                                        <TextBlock Grid.Row="2" Text="Subchannel" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DabMscSubchannelText" Text="—" FontFamily="Consolas" />
                                        <TextBlock Grid.Row="3" Text="Protection" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DabMscProtectionText" Text="—" />
                                        <TextBlock Grid.Row="4" Text="Generation" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DabMscGenerationText" Text="0" FontFamily="Consolas" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <TabViewItem x:Name="DabPlusTab" Header="DAB+" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="DabPlusFocusText"
                                       Text="Selected metric: DAB+ decoder"
                                       Foreground="{StaticResource SpectrumBrush}"
                                       FontWeight="SemiBold" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource RfMetricCardStyle}">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="DECODER" Style="{StaticResource RfMetricLabelStyle}" />
                                        <TextBlock x:Name="DabPlusStateText" Text="IDLE" Style="{StaticResource RfMetricValueStyle}" />
                                        <TextBlock x:Name="DabPlusLastDecodeText" Text="No decode attempt" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource RfMetricCardStyle}">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="SUCCESS RATE" Style="{StaticResource RfMetricLabelStyle}" />
                                        <TextBlock x:Name="DabPlusSuccessRateText" Text="—" Style="{StaticResource RfMetricValueStyle}" />
                                        <TextBlock Text="Successful superframe decodes" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource RfMetricCardStyle}">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="RS CORRECTED" Style="{StaticResource RfMetricLabelStyle}" />
                                        <TextBlock x:Name="DabPlusRsLastText" Text="0" Style="{StaticResource RfMetricValueStyle}" />
                                        <TextBlock Text="Bytes in latest superframe" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Style="{StaticResource RfMetricCardStyle}">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="RUNTIME RESETS" Style="{StaticResource RfMetricLabelStyle}" />
                                        <TextBlock x:Name="DabPlusResetsText" Text="0" Style="{StaticResource RfMetricValueStyle}" />
                                        <TextBlock Text="Selected subchannel decoder" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource PanelCardStyle}" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="DAB+ superframe decoder" FontSize="16" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="14" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Superframe generation" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Column="1" x:Name="DabPlusGenerationText" Text="0" FontFamily="Consolas" />
                                        <TextBlock Grid.Row="1" Text="Decode attempts" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DabPlusAttemptsText" Text="0" FontFamily="Consolas" />
                                        <TextBlock Grid.Row="2" Text="Decode failures" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DabPlusFailuresText" Text="0" FontFamily="Consolas" />
                                        <TextBlock Grid.Row="3" Text="RS corrected total" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DabPlusRsTotalText" Text="0" FontFamily="Consolas" />
                                        <TextBlock Grid.Row="4" Text="Last decode" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DabPlusLastDecodeDetailText" Text="—" />
                                        <TextBlock Grid.Row="5" Text="Last reconfiguration" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="DabPlusReconfigText" Text="—" FontFamily="Consolas" />
                                        <TextBlock Grid.Row="6" Text="Audio-unit CRC" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="DabPlusAudioCrcText" Text="—" FontFamily="Consolas" />
                                        <TextBlock Grid.Row="7" Text="Audio availability" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Row="7" Grid.Column="1" x:Name="DabPlusAvailabilityText" Text="—" FontFamily="Consolas" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <TabViewItem Header="Events" IsClosable="False">
                    <Grid Padding="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="4,0,4,10">
                            <TextBlock Text="DAB receiver events" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Receiver state, FIC catalogue, service selection, decoder recovery, and operator events."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11" />
                        </StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}" Padding="8">
                            <ListView x:Name="DabEventsList"
                                      SelectionMode="None"
                                      IsItemClickEnabled="False"
                                      HorizontalContentAlignment="Stretch" />
                        </Border>
                    </Grid>
                </TabViewItem>
            </TabView>
        </Grid>

        <Border Grid.Row="4" Background="#FF0B1522" BorderBrush="{StaticResource PanelStrokeBrush}" BorderThickness="0,1,0,0" Padding="12,0">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusDeviceText" Text="SDRplay RSP1A" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="StatusChannelText" Text="10C" VerticalAlignment="Center" Foreground="{StaticResource SpectrumBrush}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusSyncIndicator" Width="7" Height="7" Fill="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="StatusSyncText" Text="idle" />
                </StackPanel>
                <TextBlock Grid.Column="3" x:Name="StatusRecordText" Text="not recording" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Grid.Column="4" x:Name="StatusCalibrationText" Text="Uncalibrated" VerticalAlignment="Center" Foreground="{StaticResource WarningBrush}" />
                <TextBlock Grid.Column="5" x:Name="StatusOverrunText" Text="no overruns" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Grid.Column="7" x:Name="StatusCpuText" Text="CPU —" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" />
            </Grid>
        </Border>
    </Grid>
</Window>
