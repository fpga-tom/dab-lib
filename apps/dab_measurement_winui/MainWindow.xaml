                                            <StackPanel Spacing="7">
                                                <TextBlock Text="AUDIO-UNIT DETAIL" Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock x:Name="DabPlusAuDetailIdentityText" Text="Select an audio unit" FontFamily="Consolas" />
                                                <TextBlock x:Name="DabPlusAuDetailOffsetsText" Text="Offsets —" />
                                                <TextBlock x:Name="DabPlusAuDetailCrcText" Text="CRC —" />
                                                <TextBlock x:Name="DabPlusAuDetailDecoderText" Text="AAC —" />
                                                <TextBlock x:Name="DabPlusAuDetailFormatText" Text="SBR / PS —" />
                                                <TextBlock Text="RAW BYTES (BOUNDED PREVIEW)" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,8,0,0" />
                                                <TextBlock x:Name="DabPlusAuDetailRawText" Text="—" FontFamily="Consolas" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </TabViewItem>

                                <TabViewItem Header="Audio" IsClosable="False">
                                    <Grid Padding="8" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource PanelCardStyle}" Padding="14">
                                            <StackPanel Spacing="7">
                                                <TextBlock Text="AUDIO LEVELS" Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock x:Name="DabPlusAudioLeftRmsText" Text="Left RMS —" FontFamily="Consolas" />
                                                <TextBlock x:Name="DabPlusAudioRightRmsText" Text="Right RMS —" FontFamily="Consolas" />
                                                <TextBlock x:Name="DabPlusAudioLeftPeakText" Text="Left peak —" FontFamily="Consolas" />
                                                <TextBlock x:Name="DabPlusAudioRightPeakText" Text="Right peak —" FontFamily="Consolas" />
                                                <TextBlock x:Name="DabPlusAudioClippingText" Text="Audio clipping —" FontFamily="Consolas" />
                                                <TextBlock Text="Digital PCM level, not acoustic loudness." Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                                <TextBlock Text="AUDIO DIAGNOSTICS" Style="{StaticResource SectionTitleStyle}" Margin="0,12,0,0" />
                                                <TextBlock x:Name="DabPlusAudioFormatText" Text="Format —" FontFamily="Consolas" />
                                                <TextBlock x:Name="DabPlusAudioDecoderText" Text="Decoder —" FontFamily="Consolas" />
                                                <TextBlock x:Name="DabPlusAudioCountsText" Text="Audio units —" FontFamily="Consolas" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Padding="14">
                                            <StackPanel Spacing="7">
                                                <TextBlock Text="AUDIO CONTINUITY" Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock x:Name="DabPlusAudioValidText" Text="Valid audio —" FontFamily="Consolas" />
                                                <TextBlock x:Name="DabPlusAudioMutedText" Text="Muted audio —" FontFamily="Consolas" />
                                                <TextBlock x:Name="DabPlusAudioLongestMuteText" Text="Longest interruption —" FontFamily="Consolas" />
                                                <TextBlock x:Name="DabPlusAudioUnderrunsText" Text="Output underruns —" FontFamily="Consolas" />
                                                <TextBlock x:Name="DabPlusAudioQueueDropsText" Text="Queue drops —" FontFamily="Consolas" />
                                                <TextBlock Text="AAC concealment is not implemented; output underrun mute is measured independently."
                                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </TabViewItem>

                                <TabViewItem Header="PAD/Metadata" IsClosable="False">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                                        <StackPanel Spacing="10">
                                            <Border Style="{StaticResource PanelCardStyle}" Padding="14">
                                                <Grid ColumnSpacing="18" RowSpacing="7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="PAD access units" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Grid.Column="1" x:Name="DabPlusPadDetectedText" Text="0 detected" FontFamily="Consolas" />
                                                    <TextBlock Grid.Row="1" Text="Structural errors" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DabPlusPadErrorsText" Text="0" FontFamily="Consolas" />
                                                    <TextBlock Grid.Row="2" Text="Metadata decoder" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DabPlusPadSupportText" Text="Not implemented in the measurement receiver" Foreground="{StaticResource WarningBrush}" />
                                                    <TextBlock Grid.Row="3" Text="Diagnostic scope" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="PAD presence and framing only; no label or image content is claimed." TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                            <Grid ColumnSpacing="10" RowSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Style="{StaticResource PanelCardStyle}" Padding="14">
                                                    <StackPanel>
                                                        <TextBlock Text="Dynamic Label / DL Plus" FontWeight="SemiBold" />
                                                        <TextBlock Text="Unavailable — decoder not connected" Foreground="{StaticResource MutedTextBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Padding="14">
                                                    <StackPanel>
                                                        <TextBlock Text="SlideShow / MOT" FontWeight="SemiBold" />
                                                        <TextBlock Text="Unavailable — decoder not connected" Foreground="{StaticResource MutedTextBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}" Padding="14">
                                                    <StackPanel>
                                                        <TextBlock Text="Journaline" FontWeight="SemiBold" />
                                                        <TextBlock Text="Unavailable — decoder not connected" Foreground="{StaticResource MutedTextBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelCardStyle}" Padding="14">
                                                    <StackPanel>
                                                        <TextBlock Text="Metadata alarms" FontWeight="SemiBold" />
                                                        <TextBlock Text="Disabled until content decoding is implemented" Foreground="{StaticResource MutedTextBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabViewItem>
                            </TabView>

                            <StackPanel Visibility="Collapsed">
                            <TextBlock x:Name="DabPlusFocusText"
                                       Text="Selected metric: DAB+ decoder"
                                       Foreground="{StaticResource SpectrumBrush}"
                                       FontWeight="SemiBold" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource RfMetricCardStyle}">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="DECODER" Style="{StaticResource RfMetricLabelStyle}" />
                                        <TextBlock x:Name="DabPlusStateText" Text="IDLE" Style="{StaticResource RfMetricValueStyle}" />
                                        <TextBlock x:Name="DabPlusLastDecodeText" Text="No decode attempt" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource RfMetricCardStyle}">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="SUCCESS RATE" Style="{StaticResource RfMetricLabelStyle}" />
                                        <TextBlock x:Name="DabPlusSuccessRateText" Text="—" Style="{StaticResource RfMetricValueStyle}" />
                                        <TextBlock Text="Successful superframe decodes" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource RfMetricCardStyle}">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="RS CORRECTED" Style="{StaticResource RfMetricLabelStyle}" />
                                        <TextBlock x:Name="DabPlusRsLastText" Text="0" Style="{StaticResource RfMetricValueStyle}" />
                                        <TextBlock Text="Bytes in latest superframe" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Style="{StaticResource RfMetricCardStyle}">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="RUNTIME RESETS" Style="{StaticResource RfMetricLabelStyle}" />
                                        <TextBlock x:Name="DabPlusResetsText" Text="0" Style="{StaticResource RfMetricValueStyle}" />
                                        <TextBlock Text="Selected subchannel decoder" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource PanelCardStyle}" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="DAB+ superframe decoder" FontSize="16" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="14" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Superframe generation" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Column="1" x:Name="DabPlusGenerationText" Text="0" FontFamily="Consolas" />
                                        <TextBlock Grid.Row="1" Text="Decode attempts" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DabPlusAttemptsText" Text="0" FontFamily="Consolas" />
                                        <TextBlock Grid.Row="2" Text="Decode failures" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DabPlusFailuresText" Text="0" FontFamily="Consolas" />
                                        <TextBlock Grid.Row="3" Text="RS corrected total" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DabPlusRsTotalText" Text="0" FontFamily="Consolas" />
                                        <TextBlock Grid.Row="4" Text="Last decode" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DabPlusLastDecodeDetailText" Text="—" />
                                        <TextBlock Grid.Row="5" Text="Last reconfiguration" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="DabPlusReconfigText" Text="—" FontFamily="Consolas" />
                                        <TextBlock Grid.Row="6" Text="Audio-unit CRC" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="DabPlusAudioCrcText" Text="—" FontFamily="Consolas" />
                                        <TextBlock Grid.Row="7" Text="Audio availability" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Row="7" Grid.Column="1" x:Name="DabPlusAvailabilityText" Text="—" FontFamily="Consolas" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <TabViewItem Header="Events" IsClosable="False">
                    <Grid Padding="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="4,0,4,10">
                            <TextBlock Text="DAB receiver events" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Receiver state, FIC catalogue, service selection, decoder recovery, and operator events."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11" />
                        </StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}" Padding="8">
                            <ListView x:Name="DabEventsList"
                                      SelectionMode="None"
                                      IsItemClickEnabled="False"
                                      HorizontalContentAlignment="Stretch" />
                        </Border>
                    </Grid>
                </TabViewItem>
            </TabView>
        </Grid>

        <Border Grid.Row="4" Background="#FF0B1522" BorderBrush="{StaticResource PanelStrokeBrush}" BorderThickness="0,1,0,0" Padding="12,0">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusDeviceText" Text="SDRplay RSP1A" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="StatusChannelText" Text="10C" VerticalAlignment="Center" Foreground="{StaticResource SpectrumBrush}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusSyncIndicator" Width="7" Height="7" Fill="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="StatusSyncText" Text="idle" />
                </StackPanel>
                <TextBlock Grid.Column="3" x:Name="StatusRecordText" Text="not recording" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Grid.Column="4" x:Name="StatusCalibrationText" Text="Uncalibrated" VerticalAlignment="Center" Foreground="{StaticResource WarningBrush}" />
                <TextBlock Grid.Column="5" x:Name="StatusOverrunText" Text="no overruns" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Grid.Column="7" x:Name="StatusCpuText" Text="CPU —" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" />
            </Grid>
        </Border>
    </Grid>
</Window>
