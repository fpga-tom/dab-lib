                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Stretch="Fill">
                                            <Canvas Width="58" Height="300">
                                                <TextBlock x:Name="RfSpectrumYAxisTopText" Text="-20" FontFamily="Consolas" FontSize="11" Width="58" TextAlignment="Right" Canvas.Top="0" />
                                                <TextBlock x:Name="RfSpectrumYAxis1Text" Text="-40" FontFamily="Consolas" FontSize="11" Width="58" TextAlignment="Right" Canvas.Top="92" />
                                                <TextBlock x:Name="RfSpectrumYAxis2Text" Text="-60" FontFamily="Consolas" FontSize="11" Width="58" TextAlignment="Right" Canvas.Top="192" />
                                                <TextBlock x:Name="RfSpectrumYAxisBottomText" Text="-80 dBFS" FontFamily="Consolas" FontSize="11" Width="58" TextAlignment="Right" Canvas.Top="282" />
                                            </Canvas>
                                        </Viewbox>
                                        <Border Grid.Column="1" BorderBrush="{StaticResource PanelStrokeBrush}" BorderThickness="1" Background="#FF07101B">
