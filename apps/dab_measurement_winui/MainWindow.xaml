                                                            BorderBrush="#FF5A718A"
                                                            BorderThickness="1"
                                                            Visibility="Collapsed">
                                                        <TextBlock x:Name="RfSpectrumTooltipText" Text="— MHz · — dBFS" FontFamily="Consolas" FontSize="11" />
                                                    </Border>
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                    </Grid>
                                    <Grid Grid.Row="2" Margin="66,0,0,0">
