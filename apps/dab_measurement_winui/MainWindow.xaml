                                                <TextBlock Grid.Column="2" x:Name="RfChannelMarkerDelayText" Text="0.00 &#x00B5;s" FontFamily="Consolas" />
                                                <TextBlock Grid.Column="3" x:Name="RfChannelMarkerPowerText" Text="0.0 dB" FontFamily="Consolas" />
                                                <TextBlock Grid.Column="4" x:Name="RfChannelMarkerDistanceText" Text="0.00 km path difference" FontFamily="Consolas" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource PanelCardStyle}" Padding="14">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="92" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="Guard interval and echo energy" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock x:Name="RfChannelGuardStatusText"
                                                   Text="Mode I guard interval: 504 samples / 246.09 &#x00B5;s"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontFamily="Consolas"
                                                   FontSize="11" />
                                    </Grid>
                                    <Viewbox Grid.Row="1" Stretch="Fill">
                                        <Canvas Width="1000" Height="92">
                                            <TextBlock Canvas.Left="44" Canvas.Top="1" Text="0 &#x00B5;s" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Canvas.Left="890" Canvas.Top="1" Text="246.09 &#x00B5;s" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                            <Rectangle Canvas.Left="50" Canvas.Top="31" Width="900" Height="14" Fill="#1F35D0BA" Stroke="{StaticResource MeasurementAccentBrush}" StrokeThickness="1" RadiusX="4" RadiusY="4" />
                                            <Line X1="50" Y1="24" X2="50" Y2="53" Stroke="{StaticResource MeasurementAccentBrush}" StrokeThickness="2" />
                                            <Line X1="950" Y1="24" X2="950" Y2="53" Stroke="{StaticResource MeasurementAccentBrush}" StrokeThickness="2" />
                                            <Canvas x:Name="RfChannelGuardMarkerCanvas" Width="1000" Height="92" IsHitTestVisible="False" />
                                            <TextBlock Canvas.Left="50" Canvas.Top="61" Text="Main path" FontSize="10" Foreground="{StaticResource MeasurementAccentBrush}" />
                                            <TextBlock Canvas.Left="860" Canvas.Top="61" Text="Guard limit" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Grid.Row="2"
                                               Text="Echoes beyond the guard interval can create inter-symbol interference; percentage uses linear CIR energy."
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource PanelCardStyle}" Padding="14,11">
                                <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="OVERALL MER" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock x:Name="RfChannelOverallMerText" Text="&#x2014; dB" FontFamily="Consolas" FontSize="18" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="MINIMUM CARRIER MER" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock x:Name="RfChannelMinimumMerText" Text="&#x2014; dB" FontFamily="Consolas" FontSize="18" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="NOTCHED CARRIERS" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock x:Name="RfChannelNotchedCarrierText" Text="0" FontFamily="Consolas" FontSize="18" />
                                        <TextBlock Text="below &#x2212;12 dB response" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="SELECTIVE FADING" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock x:Name="RfChannelFadingText" Text="Awaiting response" FontFamily="Consolas" FontSize="18" />
                                        <TextBlock x:Name="RfChannelFadingSpreadText" Text="p90&#x2212;p10 &#x2014; dB" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="OUTSIDE GUARD" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock x:Name="RfChannelOutsideGuardText" Text="&#x2014; %" FontFamily="Consolas" FontSize="18" />
                                        <TextBlock x:Name="RfChannelOutsideGuardDbText" Text="&#x2014; dB energy ratio" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>
                <TabViewItem Header="History &amp; Alarms" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="12">
                        <StackPanel x:Name="RfHistoryContent" Spacing="10" Loaded="RfHistory_Loaded">
                            <Border Style="{StaticResource PanelCardStyle}" Padding="14,10">
                                <StackPanel Spacing="9">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <StackPanel Orientation="Horizontal" Spacing="9" MinWidth="970">
                                            <ComboBox x:Name="RfHistoryPeriodComboBox"
                                                      Header="PERIOD"
                                                      Width="150"
                                                      SelectedIndex="1"
                                                      SelectionChanged="RfHistoryPeriod_SelectionChanged">
                                                <ComboBoxItem Content="Last 1 minute" Tag="60" />
                                                <ComboBoxItem Content="Last 10 minutes" Tag="600" />
                                                <ComboBoxItem Content="Last 30 minutes" Tag="1800" />
                                                <ComboBoxItem Content="Last 1 hour" Tag="3600" />
                                                <ComboBoxItem Content="Since start" Tag="0" />
                                            </ComboBox>
                                            <StackPanel>
                                                <TextBlock Text="METRICS" Style="{StaticResource SectionTitleStyle}" />
                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                                    <ToggleButton x:Name="RfHistoryPowerButton" Content="Power" IsChecked="True" Click="RfHistoryControls_Changed" />
                                                    <ToggleButton x:Name="RfHistoryMerButton" Content="MER" IsChecked="True" Click="RfHistoryControls_Changed" />
                                                    <ToggleButton x:Name="RfHistoryCfoButton" Content="CFO" IsChecked="True" Click="RfHistoryControls_Changed" />
                                                    <ToggleButton x:Name="RfHistoryClippingButton" Content="Clipping" IsChecked="True" Click="RfHistoryControls_Changed" />
                                                </StackPanel>
                                            </StackPanel>
                                            <ToggleButton x:Name="RfHistoryPauseButton"
                                                          Content="Pause display"
                                                          Height="32"
                                                          VerticalAlignment="Bottom"
                                                          Click="RfHistoryPause_Click" />
                                            <Button Content="Add annotation" Height="32" VerticalAlignment="Bottom">
                                                <Button.Flyout>
                                                    <Flyout x:Name="RfHistoryAnnotationFlyout">
                                                        <StackPanel Width="330" Spacing="9">
                                                            <TextBlock Text="Measurement annotation" FontSize="16" FontWeight="SemiBold" />
                                                            <TextBox x:Name="RfHistoryAnnotationTextBox"
                                                                     Header="NOTE"
                                                                     PlaceholderText="Describe the observation or test change"
                                                                     AcceptsReturn="True"
                                                                     TextWrapping="Wrap"
                                                                     MinHeight="72" />
                                                            <Button Content="Add to timeline"
                                                                    HorizontalAlignment="Right"
                                                                    Click="RfHistoryAnnotationCommit_Click" />
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                            <Button Content="Export CSV"
                                                    Height="32"
                                                    VerticalAlignment="Bottom"
                                                    Click="RfHistoryExportCsv_Click"
                                                    ToolTipService.ToolTip="Export samples in the selected period to the Downloads folder" />
                                            <TextBlock x:Name="RfHistoryCaptureStatusText"
                                                       Text="Collecting live samples"
                                                       VerticalAlignment="Bottom"
                                                       Margin="8,0,0,7"
                                                       Foreground="{StaticResource MeasurementAccentBrush}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                    <InfoBar x:Name="RfHistoryAlarmBanner"
                                             IsOpen="False"
                                             IsClosable="False"
                                             Severity="Warning"
                                             Title="RF measurement alarm" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PanelCardStyle}" Padding="14">
                                <Grid RowSpacing="7">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="300" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Measurement timeline" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="Display pause does not stop acquisition or alarm evaluation"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11" />
                                        </StackPanel>
                                        <TextBlock x:Name="RfHistoryWindowStatusText"
                                                   Text="Last 10 minutes · awaiting samples"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontFamily="Consolas" />
                                    </Grid>
                                    <Border Grid.Row="1" BorderBrush="{StaticResource PanelStrokeBrush}" BorderThickness="1" Background="#FF07101B">
                                        <Viewbox Stretch="Fill">
                                            <Canvas Width="1000" Height="300" Background="#FF07101B">
                                                <TextBlock Canvas.Left="8" Canvas.Top="19" Text="Power" Foreground="{StaticResource SpectrumBrush}" FontSize="11" />
                                                <TextBlock x:Name="RfHistoryPowerAxisText" Canvas.Left="8" Canvas.Top="37" Text="&#x2212;100…0 dBFS" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="9" />
                                                <TextBlock Canvas.Left="8" Canvas.Top="84" Text="MER" Foreground="{StaticResource WarningBrush}" FontSize="11" />
                                                <TextBlock Canvas.Left="8" Canvas.Top="102" Text="0…40 dB" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="9" />
                                                <TextBlock Canvas.Left="8" Canvas.Top="149" Text="CFO" Foreground="{StaticResource MeasurementAccentBrush}" FontSize="11" />
                                                <TextBlock x:Name="RfHistoryCfoAxisText" Canvas.Left="8" Canvas.Top="167" Text="&#x00B1;50 Hz" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="9" />
                                                <TextBlock Canvas.Left="8" Canvas.Top="214" Text="Clipping" Foreground="#FFFF6B9A" FontSize="11" />
                                                <TextBlock x:Name="RfHistoryClippingAxisText" Canvas.Left="8" Canvas.Top="232" Text="0…1 %" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="9" />

                                                <Line X1="90" Y1="10" X2="980" Y2="10" Stroke="#253D556E" />
                                                <Line X1="90" Y1="65" X2="980" Y2="65" Stroke="#403D556E" />
                                                <Line X1="90" Y1="75" X2="980" Y2="75" Stroke="#253D556E" />
                                                <Line X1="90" Y1="130" X2="980" Y2="130" Stroke="#403D556E" />
                                                <Line X1="90" Y1="140" X2="980" Y2="140" Stroke="#253D556E" />
                                                <Line X1="90" Y1="195" X2="980" Y2="195" Stroke="#403D556E" />
                                                <Line X1="90" Y1="205" X2="980" Y2="205" Stroke="#253D556E" />
                                                <Line X1="90" Y1="260" X2="980" Y2="260" Stroke="#403D556E" />
                                                <Line X1="312.5" Y1="10" X2="312.5" Y2="260" Stroke="#183D556E" />
                                                <Line X1="535" Y1="10" X2="535" Y2="260" Stroke="#253D556E" />
                                                <Line X1="757.5" Y1="10" X2="757.5" Y2="260" Stroke="#183D556E" />
                                                <Polyline x:Name="RfLongHistoryPowerTrace" Stroke="{StaticResource SpectrumBrush}" StrokeThickness="1.8" Points="90,65 980,65" />
                                                <Polyline x:Name="RfLongHistoryMerTrace" Stroke="{StaticResource WarningBrush}" StrokeThickness="1.8" Points="90,130 980,130" />
                                                <Polyline x:Name="RfLongHistoryCfoTrace" Stroke="{StaticResource MeasurementAccentBrush}" StrokeThickness="1.8" Points="90,167.5 980,167.5" />
                                                <Polyline x:Name="RfLongHistoryClippingTrace" Stroke="#FFFF6B9A" StrokeThickness="1.8" Points="90,260 980,260" />
                                                <Canvas x:Name="RfHistoryEventMarkerCanvas" Width="1000" Height="300" IsHitTestVisible="False" />
                                                <TextBlock x:Name="RfHistoryAxisLeftText" Canvas.Left="90" Canvas.Top="270" Text="10 min ago" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="10" />
                                                <TextBlock x:Name="RfHistoryAxisCenterText" Canvas.Left="510" Canvas.Top="270" Text="5 min ago" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="10" />
                                                <TextBlock Canvas.Left="956" Canvas.Top="270" Text="now" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="10" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="14">
                                        <StackPanel Orientation="Horizontal" Spacing="5"><Rectangle Width="15" Height="3" Fill="{StaticResource SpectrumBrush}" /><TextBlock Text="Power dBFS" FontSize="10" /></StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="5"><Rectangle Width="15" Height="3" Fill="{StaticResource WarningBrush}" /><TextBlock Text="MER dB" FontSize="10" /></StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="5"><Rectangle Width="15" Height="3" Fill="{StaticResource MeasurementAccentBrush}" /><TextBlock Text="CFO Hz" FontSize="10" /></StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="5"><Rectangle Width="15" Height="3" Fill="#FFFF6B9A" /><TextBlock Text="Clipping %" FontSize="10" /></StackPanel>
                                        <TextBlock Text="▲ event / annotation" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource PanelCardStyle}" Padding="14">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="170" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="Alarms, receiver events and annotations" FontSize="16" FontWeight="SemiBold" />
                                        <Button Content="Clear events"
                                                HorizontalAlignment="Right"
                                                Click="RfHistoryClearEvents_Click" />
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="12,0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="135" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="TIME" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Grid.Column="1" Text="SEVERITY" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Grid.Column="2" Text="MEASUREMENT" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Grid.Column="3" Text="VALUE" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Grid.Column="4" Text="DESCRIPTION" Style="{StaticResource SectionTitleStyle}" />
                                    </Grid>
                                    <ListView Grid.Row="2"
                                              x:Name="RfHistoryEventList"
                                              SelectionMode="None"
                                              IsItemClickEnabled="False"
                                              HorizontalContentAlignment="Stretch" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource PanelCardStyle}" Padding="14">
                                <Grid ColumnSpacing="22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="9">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="Alarm configuration" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="Minimum duration filters short excursions; recovery threshold supplies hysteresis."
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="11" />
                                            </StackPanel>
                                            <ToggleButton x:Name="RfHistoryAlarmEnableButton"
                                                          Content="Alarm enabled"
                                                          IsChecked="True"
                                                          HorizontalAlignment="Right"
                                                          Click="RfHistoryAlarmEnable_Click" />
                                        </Grid>
                                        <Grid ColumnSpacing="9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="125" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="RfHistoryAlarmMeasurementComboBox"
                                                      Header="MEASUREMENT"
                                                      SelectedIndex="0"
                                                      SelectionChanged="RfHistoryAlarmMeasurement_SelectionChanged">
                                                <ComboBoxItem Content="MER" />
                                                <ComboBoxItem Content="Power (dBFS)" />
                                                <ComboBoxItem Content="CFO magnitude" />
                                                <ComboBoxItem Content="Clipping" />
                                            </ComboBox>
                                            <ComboBox Grid.Column="1" x:Name="RfHistoryAlarmConditionComboBox" Header="CONDITION" SelectedIndex="0">
                                                <ComboBoxItem Content="Less than" />
                                                <ComboBoxItem Content="Greater than" />
                                            </ComboBox>
                                            <NumberBox Grid.Column="2" x:Name="RfHistoryAlarmThresholdBox" Header="THRESHOLD" Value="12" SmallChange="0.5" SpinButtonPlacementMode="Compact" />
                                            <NumberBox Grid.Column="3" x:Name="RfHistoryAlarmDurationBox" Header="DURATION (s)" Value="3" Minimum="0" Maximum="3600" SmallChange="0.5" SpinButtonPlacementMode="Compact" />
                                            <NumberBox Grid.Column="4" x:Name="RfHistoryAlarmRecoveryBox" Header="RECOVERY" Value="14" SmallChange="0.5" SpinButtonPlacementMode="Compact" />
                                        </Grid>
                                        <Grid>
                                            <TextBlock x:Name="RfHistoryAlarmStateText"
                                                       Text="Armed: MER &lt; 12 dB for 3 s · recovery ≥ 14 dB"
                                                       Foreground="{StaticResource MeasurementAccentBrush}"
                                                       FontFamily="Consolas"
                                                       VerticalAlignment="Center" />
                                            <Button Content="Apply configuration"
                                                    HorizontalAlignment="Right"
                                                    Click="RfHistoryAlarmApply_Click" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="7">
                                        <TextBlock Text="Actions" FontSize="16" FontWeight="SemiBold" />
                                        <CheckBox x:Name="RfHistoryAlarmAddEventCheckBox" Content="Add event" IsChecked="True" />
                                        <CheckBox Content="Capture IQ"
                                                  IsEnabled="False"
                                                  ToolTipService.ToolTip="Raw IQ capture is not exposed by the receiver pipeline yet" />
                                        <CheckBox x:Name="RfHistoryAlarmNotificationCheckBox" Content="Show in-app notification" IsChecked="True" />
                                        <CheckBox Content="Play sound" IsEnabled="False" ToolTipService.ToolTip="Alarm audio output is not implemented" />
                                        <TextBlock Text="Unavailable actions remain disabled until the raw-IQ recorder and alarm audio backend are present."
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>
            </TabView>
        </Grid>

        <Grid x:Name="DabWorkspace"
              Grid.Row="2"
              Grid.RowSpan="2"
              Margin="140,10,10,10"
              HorizontalAlignment="Left"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The context header deliberately lives outside the TabView so every
                 DAB measurement page retains the same operator context. -->
            <Border Grid.Row="0" Style="{StaticResource PanelCardStyle}" Padding="18,13" Margin="0,0,0,10">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="DAB MEASUREMENTS" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock x:Name="DabContextText"
                                   Text="10C · 213.360 MHz · Ensemble: Awaiting FIC · Service: Not selected"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="DabComponentContextText"
                                   Text="Component: Awaiting service component"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Padding="10,4" CornerRadius="12" Background="#2935D0BA">
                            <TextBlock x:Name="DabModeBadgeText"
                                       Text="IDLE"
                                       Foreground="{StaticResource MeasurementAccentBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </Border>
                        <Border Padding="10,4" CornerRadius="12" Background="#29FFC857">
                            <TextBlock x:Name="DabSyncBadgeText"
                                       Text="NOT SYNCED"
                                       Foreground="{StaticResource WarningBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <TabView x:Name="DabTabView"
                     Grid.Row="1"
                     IsAddTabButtonVisible="False"
                     TabWidthMode="SizeToContent">
                <TabViewItem x:Name="DabOverviewTab" Header="Overview" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Disabled"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="12">
                        <StackPanel x:Name="DabOverviewContent" Spacing="12">
                            <Border Style="{StaticResource PanelCardStyle}" Padding="16,13">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="DECODE PIPELINE" Style="{StaticResource SectionTitleStyle}" />
                                    <Grid ColumnSpacing="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="6">
                                            <TextBlock Text="RF LOCKED" FontWeight="SemiBold" />
                                            <Ellipse x:Name="DabPipelineRfIndicator" Width="12" Height="12" Fill="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="DabPipelineRfStateText" Text="IDLE" FontSize="10" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="1" Glyph="&#xE72A;" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="6">
                                            <TextBlock Text="FIC VALID" FontWeight="SemiBold" />
                                            <Ellipse x:Name="DabPipelineFicIndicator" Width="12" Height="12" Fill="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="DabPipelineFicStateText" Text="WAITING" FontSize="10" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="3" Glyph="&#xE72A;" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="4" HorizontalAlignment="Center" Spacing="6">
                                            <TextBlock Text="MSC VALID" FontWeight="SemiBold" />
                                            <Ellipse x:Name="DabPipelineMscIndicator" Width="12" Height="12" Fill="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="DabPipelineMscStateText" Text="WAITING" FontSize="10" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="5" Glyph="&#xE72A;" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="6" HorizontalAlignment="Center" Spacing="6">
                                            <TextBlock Text="DAB+ VALID" FontWeight="SemiBold" />
                                            <Ellipse x:Name="DabPipelineDabIndicator" Width="12" Height="12" Fill="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="DabPipelineDabStateText" Text="WAITING" FontSize="10" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="7" Glyph="&#xE72A;" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="8" HorizontalAlignment="Center" Spacing="6">
                                            <TextBlock Text="AUDIO PLAYING" FontWeight="SemiBold" />
                                            <Ellipse x:Name="DabPipelineAudioIndicator" Width="12" Height="12" Fill="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="DabPipelineAudioStateText" Text="STOPPED" FontSize="10" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid ColumnSpacing="10" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
