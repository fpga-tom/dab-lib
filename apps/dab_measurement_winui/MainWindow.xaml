                                                <ComboBoxItem Content="2048" />
                                            </ComboBox>
                                            <StackPanel Width="104">
                                                <TextBlock Text="RBW" Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock x:Name="RfSpectrumRbwText"
                                                           Text="1.000 kHz"
