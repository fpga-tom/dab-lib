                                    Spacing="10"
                                    Loaded="RfSpectrum_Loaded">
                            <Border Style="{StaticResource PanelCardStyle}" Padding="14,10">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="Spectrum controls" FontSize="15" FontWeight="SemiBold" />
