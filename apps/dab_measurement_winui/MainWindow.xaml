                                                        PointerPressed="RfSpectrumCanvas_PointerPressed"
                                                        PointerMoved="RfSpectrumCanvas_PointerMoved"
                                                        PointerReleased="RfSpectrumCanvas_PointerReleased"
                                                        PointerExited="RfSpectrumCanvas_PointerExited"
                                                        PointerCaptureLost="RfSpectrumCanvas_PointerCaptureLost"
                                                        DoubleTapped="RfSpectrumCanvas_DoubleTapped">
