<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DabMeasurementWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DabMeasurementWinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Closed="Window_Closed"
    Title="DAB+ Measurement Workbench">

        <Grid x:Name="RootLayout"
          Background="{StaticResource WorkspaceBrush}"
          RequestedTheme="Dark"
          Loaded="RootLayout_Loaded"
          SizeChanged="RootLayout_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="156" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0" Background="{StaticResource PanelBrush}">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="New measurement session"
                                Click="FileNewSession_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+N">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Open recording..."
                                IsEnabled="False"
                                ToolTipService.ToolTip="Recording replay is not implemented yet"
                                KeyboardAcceleratorTextOverride="Ctrl+O" />
                <MenuFlyoutSubItem Text="Recent recordings" IsEnabled="False">
                    <MenuFlyoutItem Text="No recent recordings" IsEnabled="False" />
                </MenuFlyoutSubItem>
                <MenuFlyoutItem Text="Close session"
                                Click="FileCloseSession_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+W">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="W" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Save measurement snapshot to Downloads"
                                Click="FileSaveSnapshot_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+S">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSubItem Text="Export">
                    <MenuFlyoutItem Text="Current measurements as CSV"
                                    Click="FileExportMeasurementsCsv_Click"
                                    KeyboardAcceleratorTextOverride="Ctrl+E">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="E" Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Events and alarms as CSV"
                                    Click="FileExportEventsCsv_Click" />
                    <MenuFlyoutItem Text="Measurement report..."
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="Report generation is not implemented yet" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Current workspace screenshot"
                                    Click="FileSaveScreenshot_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit"
                                Click="FileExit_Click"
                                KeyboardAcceleratorTextOverride="Alt+F4" />
            </MenuBarItem>
            <MenuBarItem Title="Receiver">
                <MenuFlyoutItem x:Name="ReceiverStartStopMenuItem"
                                Text="Start receiver"
                                Click="ReceiverStartStop_Click"
                                KeyboardAcceleratorTextOverride="F5">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem x:Name="ReceiverDeviceSubmenu" Text="Device">
                    <ToggleMenuFlyoutItem x:Name="ReceiverSdrplayMenuItem"
                                          Text="SDRplay RSP1A"
                                          Tag="0"
                                          IsChecked="True"
                                          Click="ReceiverDevice_Click" />
                    <ToggleMenuFlyoutItem x:Name="ReceiverRtlSdrMenuItem"
                                          Text="RTL-SDR"
                                          Tag="1"
                                          Click="ReceiverDevice_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Device setup..."
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="Device-specific setup is not implemented yet" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem x:Name="ReceiverChannelSubmenu" Text="Band III channel">
                    <MenuFlyoutItem x:Name="ReceiverChannelStatusMenuItem"
                                    Text="Current: 10C · 213.360 MHz"
                                    IsEnabled="False" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Previous channel"
                                    Click="ReceiverPreviousChannel_Click" />
                    <MenuFlyoutItem Text="Next channel"
                                    Click="ReceiverNextChannel_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutSubItem Text="Blocks 5–9">
                        <MenuFlyoutItem Text="5A · 174.928 MHz" Tag="0" Click="ReceiverChannel_Click" />
                        <MenuFlyoutItem Text="5B · 176.640 MHz" Tag="1" Click="ReceiverChannel_Click" />
                        <MenuFlyoutItem Text="5C · 178.352 MHz" Tag="2" Click="ReceiverChannel_Click" />
                        <MenuFlyoutItem Text="5D · 180.064 MHz" Tag="3" Click="ReceiverChannel_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="6A · 181.936 MHz" Tag="4" Click="ReceiverChannel_Click" />
                        <MenuFlyoutItem Text="6B · 183.648 MHz" Tag="5" Click="ReceiverChannel_Click" />
                        <MenuFlyoutItem Text="6C · 185.360 MHz" Tag="6" Click="ReceiverChannel_Click" />
                        <MenuFlyoutItem Text="6D · 187.072 MHz" Tag="7" Click="ReceiverChannel_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="7A · 188.928 MHz" Tag="8" Click="ReceiverChannel_Click" />
                        <MenuFlyoutItem Text="7B · 190.640 MHz" Tag="9" Click="ReceiverChannel_Click" />
                        <MenuFlyoutItem Text="7C · 192.352 MHz" Tag="10" Click="ReceiverChannel_Click" />
                        <MenuFlyoutItem Text="7D · 194.064 MHz" Tag="11" Click="ReceiverChannel_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="8A · 195.936 MHz" Tag="12" Click="ReceiverChannel_Click" />
                        <MenuFlyoutItem Text="8B · 197.648 MHz" Tag="13" Click="ReceiverChannel_Click" />
                        <MenuFlyoutItem Text="8C · 199.360 MHz" Tag="14" Click="ReceiverChannel_Click" />
                        <MenuFlyoutItem Text="8D · 201.072 MHz" Tag="15" Click="ReceiverChannel_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="9A · 202.928 MHz" Tag="16" Click="ReceiverChannel_Click" />
                        <MenuFlyoutItem Text="9B · 204.640 MHz" Tag="17" Click="ReceiverChannel_Click" />
                        <MenuFlyoutItem Text="9C · 206.352 MHz" Tag="18" Click="ReceiverChannel_Click" />
                        <MenuFlyoutItem Text="9D · 208.064 MHz" Tag="19" Click="ReceiverChannel_Click" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSubItem Text="Blocks 10–13">
                        <MenuFlyoutItem Text="10A · 209.936 MHz" Tag="20" Click="ReceiverChannel_Click" />
                        <MenuFlyoutItem Text="10B · 211.648 MHz" Tag="21" Click="ReceiverChannel_Click" />
                        <MenuFlyoutItem Text="10C · 213.360 MHz" Tag="22" Click="ReceiverChannel_Click" />
                        <MenuFlyoutItem Text="10D · 215.072 MHz" Tag="23" Click="ReceiverChannel_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="11A · 216.928 MHz" Tag="24" Click="ReceiverChannel_Click" />
                        <MenuFlyoutItem Text="11B · 218.640 MHz" Tag="25" Click="ReceiverChannel_Click" />
                        <MenuFlyoutItem Text="11C · 220.352 MHz" Tag="26" Click="ReceiverChannel_Click" />
                        <MenuFlyoutItem Text="11D · 222.064 MHz" Tag="27" Click="ReceiverChannel_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="12A · 223.936 MHz" Tag="28" Click="ReceiverChannel_Click" />
                        <MenuFlyoutItem Text="12B · 225.648 MHz" Tag="29" Click="ReceiverChannel_Click" />
                        <MenuFlyoutItem Text="12C · 227.360 MHz" Tag="30" Click="ReceiverChannel_Click" />
                        <MenuFlyoutItem Text="12D · 229.072 MHz" Tag="31" Click="ReceiverChannel_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="13A · 230.784 MHz" Tag="32" Click="ReceiverChannel_Click" />
                        <MenuFlyoutItem Text="13B · 232.496 MHz" Tag="33" Click="ReceiverChannel_Click" />
                        <MenuFlyoutItem Text="13C · 234.208 MHz" Tag="34" Click="ReceiverChannel_Click" />
                        <MenuFlyoutItem Text="13D · 235.776 MHz" Tag="35" Click="ReceiverChannel_Click" />
                        <MenuFlyoutItem Text="13E · 237.488 MHz" Tag="36" Click="ReceiverChannel_Click" />
                        <MenuFlyoutItem Text="13F · 239.200 MHz" Tag="37" Click="ReceiverChannel_Click" />
                    </MenuFlyoutSubItem>
                </MenuFlyoutSubItem>
                <MenuFlyoutItem x:Name="ReceiverEnterFrequencyMenuItem"
                                Text="Enter frequency..."
                                Click="ReceiverEnterFrequency_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+L">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="L" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Scan Band III..."
                                IsEnabled="False"
                                ToolTipService.ToolTip="Band scanning is not integrated with this application yet" />
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem x:Name="ReceiverGainSubmenu" Text="Gain">
                    <MenuFlyoutItem x:Name="ReceiverGainStatusMenuItem"
                                    Text="Current: 40 dB"
                                    IsEnabled="False" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Decrease 1 dB" Tag="-1" Click="ReceiverGainAdjust_Click" />
                    <MenuFlyoutItem Text="Increase 1 dB" Tag="1" Click="ReceiverGainAdjust_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="20 dB" Tag="20" Click="ReceiverGainPreset_Click" />
                    <MenuFlyoutItem Text="30 dB" Tag="30" Click="ReceiverGainPreset_Click" />
                    <MenuFlyoutItem Text="40 dB" Tag="40" Click="ReceiverGainPreset_Click" />
                    <MenuFlyoutItem Text="50 dB" Tag="50" Click="ReceiverGainPreset_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem x:Name="ReceiverFrontEndSubmenu" Text="Front end">
                    <ToggleMenuFlyoutItem x:Name="ReceiverAgcMenuItem"
                                          Text="Automatic gain control"
                                          Click="ReceiverAgc_Click" />
                    <ToggleMenuFlyoutItem x:Name="ReceiverBiasTeeMenuItem"
                                          Text="Bias tee"
                                          Click="ReceiverBiasTee_Click" />
                    <MenuFlyoutSubItem x:Name="ReceiverPpmSubmenu" Text="Frequency correction">
                        <MenuFlyoutItem x:Name="ReceiverPpmStatusMenuItem"
                                        Text="Current: 0 ppm"
                                        IsEnabled="False" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Decrease 1 ppm" Tag="-1" Click="ReceiverPpmAdjust_Click" />
                        <MenuFlyoutItem Text="Reset to 0 ppm" Tag="reset" Click="ReceiverPpmAdjust_Click" />
                        <MenuFlyoutItem Text="Increase 1 ppm" Tag="1" Click="ReceiverPpmAdjust_Click" />
                    </MenuFlyoutSubItem>
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Open service browser"
                                Click="ReceiverOpenServiceBrowser_Click" />
                <MenuFlyoutItem Text="Audio output device..."
                                IsEnabled="False"
                                ToolTipService.ToolTip="The receiver currently uses the system default audio output" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="RF input and transport diagnostics"
                                Click="ReceiverDiagnostics_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Measurement">
                <MenuFlyoutSubItem Text="RF Measurements">
                    <MenuFlyoutItem Text="Overview"
                                    Tag="0"
                                    Click="MeasurementRfPage_Click" />
                    <MenuFlyoutItem Text="Spectrum"
                                    Tag="1"
                                    Click="MeasurementRfPage_Click" />
                    <MenuFlyoutItem Text="RF input"
                                    Tag="2"
                                    Click="MeasurementRfPage_Click" />
                    <MenuFlyoutItem Text="Null symbol scope"
                                    Tag="3"
                                    Click="MeasurementRfPage_Click" />
                    <MenuFlyoutItem Text="Frequency and sync"
                                    Tag="4"
                                    Click="MeasurementRfPage_Click" />
                    <MenuFlyoutItem Text="Channel and CIR"
                                    Tag="5"
                                    Click="MeasurementRfPage_Click" />
                    <MenuFlyoutItem Text="History and alarms"
                                    Tag="6"
                                    Click="MeasurementRfPage_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem Text="DAB Measurements">
                    <MenuFlyoutItem Text="Overview"
                                    Tag="overview"
                                    Click="MeasurementDabPage_Click" />
                    <MenuFlyoutSubItem Text="FIC">
                        <MenuFlyoutItem Text="Overview" Tag="fic:0" Click="MeasurementDabPage_Click" />
                        <MenuFlyoutItem Text="FIB timeline" Tag="fic:1" Click="MeasurementDabPage_Click" />
                        <MenuFlyoutItem Text="FIG browser" Tag="fic:2" Click="MeasurementDabPage_Click" />
                        <MenuFlyoutItem Text="Multiplex database" Tag="fic:3" Click="MeasurementDabPage_Click" />
                        <MenuFlyoutItem Text="Raw inspector" Tag="fic:4" Click="MeasurementDabPage_Click" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSubItem Text="MSC">
                        <MenuFlyoutItem Text="Overview" Tag="msc:0" Click="MeasurementDabPage_Click" />
                        <MenuFlyoutItem Text="Capacity map" Tag="msc:1" Click="MeasurementDabPage_Click" />
                        <MenuFlyoutItem Text="Subchannels" Tag="msc:2" Click="MeasurementDabPage_Click" />
                        <MenuFlyoutItem Text="Error timeline" Tag="msc:3" Click="MeasurementDabPage_Click" />
                        <MenuFlyoutItem Text="Buffers" Tag="msc:4" Click="MeasurementDabPage_Click" />
                        <MenuFlyoutItem Text="Raw data" Tag="msc:5" Click="MeasurementDabPage_Click" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSubItem Text="DAB+">
                        <MenuFlyoutItem Text="Overview" Tag="dabplus:0" Click="MeasurementDabPage_Click" />
                        <MenuFlyoutItem Text="Superframes" Tag="dabplus:1" Click="MeasurementDabPage_Click" />
                        <MenuFlyoutItem Text="Reed-Solomon" Tag="dabplus:2" Click="MeasurementDabPage_Click" />
                        <MenuFlyoutItem Text="Audio units" Tag="dabplus:3" Click="MeasurementDabPage_Click" />
                        <MenuFlyoutItem Text="Audio" Tag="dabplus:4" Click="MeasurementDabPage_Click" />
                        <MenuFlyoutItem Text="PAD and metadata" Tag="dabplus:5" Click="MeasurementDabPage_Click" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutItem Text="Events"
                                    Tag="events"
                                    Click="MeasurementDabPage_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem Text="Capture">
                    <MenuFlyoutItem Text="Measurement snapshot"
                                    Click="FileSaveSnapshot_Click"
                                    KeyboardAcceleratorTextOverride="Ctrl+S" />
                    <MenuFlyoutItem Text="Last triggered IQ"
                                    Click="MeasurementCaptureIq_Click" />
                    <MenuFlyoutItem Text="Current workspace screenshot"
                                    Click="FileSaveScreenshot_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutItem Text="Add operator annotation"
                                Click="MeasurementAddAnnotation_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem Text="Alarm configuration">
                    <MenuFlyoutItem Text="RF history thresholds..."
                                    Click="MeasurementAlarmThresholds_Click" />
                    <MenuFlyoutItem Text="DAB decode thresholds..."
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="DAB alarm threshold editing is not implemented yet" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem Text="Measurement profile">
                    <MenuFlyoutItem Text="New profile..."
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="Measurement profiles are not implemented yet" />
                    <MenuFlyoutItem Text="Load profile..."
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="Measurement profiles are not implemented yet" />
                    <MenuFlyoutItem Text="Save current profile..."
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="Measurement profiles are not implemented yet" />
                </MenuFlyoutSubItem>
                <MenuFlyoutItem Text="RF calibration profile..."
                                IsEnabled="False"
                                ToolTipService.ToolTip="RF calibration profile management is not implemented yet" />
            </MenuBarItem>
            <MenuBarItem Title="View">
                <MenuFlyoutItem Text="Receiver workspace" Click="ReceiverWorkspace_Click" />
                <MenuFlyoutItem Text="RF Measurements" Click="RfMeasurements_Click" />
                <MenuFlyoutItem Text="DAB Measurements" Click="DabMeasurements_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Spectrum and waterfall" />
                <MenuFlyoutItem Text="Constellation" />
                <MenuFlyoutItem Text="Timeline" />
            </MenuBarItem>
            <MenuBarItem Title="Tools">
                <MenuFlyoutItem Text="Device diagnostics" />
                <MenuFlyoutItem Text="Recording browser" />
            </MenuBarItem>
            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="About DAB+ Measurement Workbench" />
            </MenuBarItem>
        </MenuBar>

        <Border Grid.Row="1"
                Padding="12,8"
                Background="{StaticResource PanelRaisedBrush}"
                BorderBrush="{StaticResource PanelStrokeBrush}"
                BorderThickness="0,1,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <Grid MinWidth="950" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="145" />
                        <ColumnDefinition Width="75" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="75" />
                        <ColumnDefinition Width="85" />
                        <ColumnDefinition Width="85" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" x:Name="DeviceComboBox" Header="DEVICE" SelectedIndex="0">
                        <ComboBoxItem Content="SDRplay RSP1A" />
                        <ComboBoxItem Content="RTL-SDR" />
                    </ComboBox>
                    <ComboBox Grid.Column="1"
                              x:Name="ChannelComboBox"
                              Header="CHANNEL"
                              SelectedIndex="22"
                              SelectionChanged="ChannelComboBox_SelectionChanged">
                        <ComboBoxItem Content="5A" Tag="174.928" />
                        <ComboBoxItem Content="5B" Tag="176.640" />
                        <ComboBoxItem Content="5C" Tag="178.352" />
                        <ComboBoxItem Content="5D" Tag="180.064" />
                        <ComboBoxItem Content="6A" Tag="181.936" />
                        <ComboBoxItem Content="6B" Tag="183.648" />
                        <ComboBoxItem Content="6C" Tag="185.360" />
                        <ComboBoxItem Content="6D" Tag="187.072" />
                        <ComboBoxItem Content="7A" Tag="188.928" />
                        <ComboBoxItem Content="7B" Tag="190.640" />
                        <ComboBoxItem Content="7C" Tag="192.352" />
                        <ComboBoxItem Content="7D" Tag="194.064" />
                        <ComboBoxItem Content="8A" Tag="195.936" />
                        <ComboBoxItem Content="8B" Tag="197.648" />
                        <ComboBoxItem Content="8C" Tag="199.360" />
                        <ComboBoxItem Content="8D" Tag="201.072" />
                        <ComboBoxItem Content="9A" Tag="202.928" />
                        <ComboBoxItem Content="9B" Tag="204.640" />
                        <ComboBoxItem Content="9C" Tag="206.352" />
                        <ComboBoxItem Content="9D" Tag="208.064" />
                        <ComboBoxItem Content="10A" Tag="209.936" />
                        <ComboBoxItem Content="10B" Tag="211.648" />
                        <ComboBoxItem Content="10C" Tag="213.360" />
                        <ComboBoxItem Content="10D" Tag="215.072" />
                        <ComboBoxItem Content="11A" Tag="216.928" />
                        <ComboBoxItem Content="11B" Tag="218.640" />
                        <ComboBoxItem Content="11C" Tag="220.352" />
                        <ComboBoxItem Content="11D" Tag="222.064" />
                        <ComboBoxItem Content="12A" Tag="223.936" />
                        <ComboBoxItem Content="12B" Tag="225.648" />
                        <ComboBoxItem Content="12C" Tag="227.360" />
                        <ComboBoxItem Content="12D" Tag="229.072" />
                        <ComboBoxItem Content="13A" Tag="230.784" />
                        <ComboBoxItem Content="13B" Tag="232.496" />
                        <ComboBoxItem Content="13C" Tag="234.208" />
                        <ComboBoxItem Content="13D" Tag="235.776" />
                        <ComboBoxItem Content="13E" Tag="237.488" />
                        <ComboBoxItem Content="13F" Tag="239.200" />
                    </ComboBox>
                    <TextBox Grid.Column="2" x:Name="FrequencyTextBox" Header="FREQUENCY" Text="213.360 MHz" />
                    <NumberBox Grid.Column="3" x:Name="GainNumberBox" Header="GAIN" Value="40" SpinButtonPlacementMode="Compact" />

                    <Button Grid.Column="4"
                            x:Name="StartButton"
                            Height="34"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch"
                            Click="StartButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock x:Name="StartButtonLabel" Text="Start" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="5"
                            x:Name="RecordButton"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Recording will be added after the live receiver path is validated"
                            Height="34"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch"
                            Click="RecordButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7C8;" FontSize="14" />
                            <TextBlock x:Name="RecordButtonLabel" Text="Record" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="6"
                            x:Name="RfToolbarButton"
                            Height="34"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch"
                            Click="RfMeasurements_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="RF" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="7"
                            x:Name="DabToolbarButton"
                            Height="34"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch"
                            Click="DabMeasurements_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="DAB" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="8"
                            Height="34"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch"
                            Click="AudioButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Audio" />
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="9" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Padding="10,4" CornerRadius="12" Background="#2935D0BA">
                            <TextBlock x:Name="DataModeText" Text="LIVE METRICS" Foreground="{StaticResource MeasurementAccentBrush}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock x:Name="DataSeamText" Text="receiver stopped" Margin="0,4,0,0" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <Border x:Name="WorkspaceNavigationPanel"
                Grid.Row="2"
                Grid.RowSpan="2"
                Width="120"
                Margin="10"
                HorizontalAlignment="Left"
                Style="{StaticResource PanelCardStyle}"
                Padding="10">
            <StackPanel Spacing="8">
                <TextBlock Text="WORKSPACES" Style="{StaticResource SectionTitleStyle}" Margin="6,4,0,6" />
                <Button x:Name="ReceiverNavigationButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Click="ReceiverWorkspace_Click">
                    <Grid ColumnSpacing="9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="ReceiverNavIndicator" Width="8" Height="8" Fill="{StaticResource MeasurementAccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Receiver" />
                    </Grid>
                </Button>
                <Button x:Name="RfNavigationButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Click="RfMeasurements_Click">
                    <Grid ColumnSpacing="9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="RfNavIndicator" Width="8" Height="8" Fill="{StaticResource MeasurementAccentBrush}" Visibility="Collapsed" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="0">
                            <TextBlock Text="RF" />
                            <TextBlock Text="Measurements" FontSize="10" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Button x:Name="DabNavigationButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Click="DabMeasurements_Click">
                    <Grid ColumnSpacing="9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="DabNavIndicator" Width="8" Height="8" Fill="{StaticResource MeasurementAccentBrush}" Visibility="Collapsed" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="0">
                            <TextBlock Text="DAB" />
                            <TextBlock Text="Measurements" FontSize="10" />
                        </StackPanel>
                    </Grid>
                </Button>
            </StackPanel>
        </Border>

        <Grid x:Name="ReceiverWorkspaceMain" Grid.Row="2" Margin="140,10,10,10" ColumnSpacing="10" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="175" MinWidth="150" />
                <ColumnDefinition Width="*" MinWidth="350" />
                <ColumnDefinition Width="175" MinWidth="160" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ReceiverCatalogPanel" Grid.Column="0" Style="{StaticResource PanelCardStyle}" Padding="14">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
