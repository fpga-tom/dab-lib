<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DabMeasurementWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DabMeasurementWinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Closed="Window_Closed"
    Title="DAB+ Measurement Workbench">

    <Grid x:Name="RootLayout"
          Background="{StaticResource WorkspaceBrush}"
          RequestedTheme="Dark"
          SizeChanged="RootLayout_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="156" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0" Background="{StaticResource PanelBrush}">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="New measurement" />
                <MenuFlyoutItem Text="Open session..." />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Export snapshot..." />
            </MenuBarItem>
            <MenuBarItem Title="Receiver">
                <MenuFlyoutItem Text="Device setup..." />
                <MenuFlyoutItem Text="Band III channel plan" />
            </MenuBarItem>
            <MenuBarItem Title="Measurement">
                <MenuFlyoutItem Text="New measurement profile..." />
                <MenuFlyoutItem Text="Alarm thresholds..." />
            </MenuBarItem>
            <MenuBarItem Title="View">
                <MenuFlyoutItem Text="Receiver workspace" Click="ReceiverWorkspace_Click" />
                <MenuFlyoutItem Text="RF Measurements" Click="RfMeasurements_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Spectrum and waterfall" />
                <MenuFlyoutItem Text="Constellation" />
                <MenuFlyoutItem Text="Timeline" />
            </MenuBarItem>
            <MenuBarItem Title="Tools">
                <MenuFlyoutItem Text="Device diagnostics" />
                <MenuFlyoutItem Text="Recording browser" />
            </MenuBarItem>
            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="About DAB+ Measurement Workbench" />
            </MenuBarItem>
        </MenuBar>

        <Border Grid.Row="1"
                Padding="12,8"
                Background="{StaticResource PanelRaisedBrush}"
                BorderBrush="{StaticResource PanelStrokeBrush}"
                BorderThickness="0,1,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <Grid MinWidth="890" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="145" />
                        <ColumnDefinition Width="75" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="75" />
                        <ColumnDefinition Width="85" />
                        <ColumnDefinition Width="85" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" x:Name="DeviceComboBox" Header="DEVICE" SelectedIndex="0">
                        <ComboBoxItem Content="SDRplay RSP1A" />
                        <ComboBoxItem Content="RTL-SDR" />
                    </ComboBox>
                    <ComboBox Grid.Column="1"
                              x:Name="ChannelComboBox"
                              Header="CHANNEL"
                              SelectedIndex="22"
                              SelectionChanged="ChannelComboBox_SelectionChanged">
                        <ComboBoxItem Content="5A" Tag="174.928" />
                        <ComboBoxItem Content="5B" Tag="176.640" />
                        <ComboBoxItem Content="5C" Tag="178.352" />
                        <ComboBoxItem Content="5D" Tag="180.064" />
                        <ComboBoxItem Content="6A" Tag="181.936" />
                        <ComboBoxItem Content="6B" Tag="183.648" />
                        <ComboBoxItem Content="6C" Tag="185.360" />
                        <ComboBoxItem Content="6D" Tag="187.072" />
                        <ComboBoxItem Content="7A" Tag="188.928" />
                        <ComboBoxItem Content="7B" Tag="190.640" />
                        <ComboBoxItem Content="7C" Tag="192.352" />
                        <ComboBoxItem Content="7D" Tag="194.064" />
                        <ComboBoxItem Content="8A" Tag="195.936" />
                        <ComboBoxItem Content="8B" Tag="197.648" />
                        <ComboBoxItem Content="8C" Tag="199.360" />
                        <ComboBoxItem Content="8D" Tag="201.072" />
                        <ComboBoxItem Content="9A" Tag="202.928" />
                        <ComboBoxItem Content="9B" Tag="204.640" />
                        <ComboBoxItem Content="9C" Tag="206.352" />
                        <ComboBoxItem Content="9D" Tag="208.064" />
                        <ComboBoxItem Content="10A" Tag="209.936" />
                        <ComboBoxItem Content="10B" Tag="211.648" />
                        <ComboBoxItem Content="10C" Tag="213.360" />
                        <ComboBoxItem Content="10D" Tag="215.072" />
                        <ComboBoxItem Content="11A" Tag="216.928" />
                        <ComboBoxItem Content="11B" Tag="218.640" />
                        <ComboBoxItem Content="11C" Tag="220.352" />
                        <ComboBoxItem Content="11D" Tag="222.064" />
                        <ComboBoxItem Content="12A" Tag="223.936" />
                        <ComboBoxItem Content="12B" Tag="225.648" />
                        <ComboBoxItem Content="12C" Tag="227.360" />
                        <ComboBoxItem Content="12D" Tag="229.072" />
                        <ComboBoxItem Content="13A" Tag="230.784" />
                        <ComboBoxItem Content="13B" Tag="232.496" />
                        <ComboBoxItem Content="13C" Tag="234.208" />
                        <ComboBoxItem Content="13D" Tag="235.776" />
                        <ComboBoxItem Content="13E" Tag="237.488" />
                        <ComboBoxItem Content="13F" Tag="239.200" />
                    </ComboBox>
                    <TextBox Grid.Column="2" x:Name="FrequencyTextBox" Header="FREQUENCY" Text="213.360 MHz" />
                    <NumberBox Grid.Column="3" x:Name="GainNumberBox" Header="GAIN" Value="40" SpinButtonPlacementMode="Compact" />

                    <Button Grid.Column="4"
                            x:Name="StartButton"
                            Height="34"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch"
                            Click="StartButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock x:Name="StartButtonLabel" Text="Start" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="5"
                            x:Name="RecordButton"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Recording will be added after the live receiver path is validated"
                            Height="34"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch"
                            Click="RecordButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7C8;" FontSize="14" />
                            <TextBlock x:Name="RecordButtonLabel" Text="Record" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="6"
                            x:Name="RfToolbarButton"
                            Height="34"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch"
                            Click="RfMeasurements_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="RF" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="7"
                            Height="34"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch"
                            Click="AudioButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Audio" />
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Padding="10,4" CornerRadius="12" Background="#2935D0BA">
                            <TextBlock x:Name="DataModeText" Text="LIVE METRICS" Foreground="{StaticResource MeasurementAccentBrush}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock x:Name="DataSeamText" Text="receiver stopped" Margin="0,4,0,0" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Grid.RowSpan="2"
                Width="120"
                Margin="10"
                HorizontalAlignment="Left"
                Style="{StaticResource PanelCardStyle}"
                Padding="10">
            <StackPanel Spacing="8">
                <TextBlock Text="WORKSPACES" Style="{StaticResource SectionTitleStyle}" Margin="6,4,0,6" />
                <Button x:Name="ReceiverNavigationButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Click="ReceiverWorkspace_Click">
                    <Grid ColumnSpacing="9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="ReceiverNavIndicator" Width="8" Height="8" Fill="{StaticResource MeasurementAccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Receiver" />
                    </Grid>
                </Button>
                <Button x:Name="RfNavigationButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Click="RfMeasurements_Click">
                    <Grid ColumnSpacing="9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="RfNavIndicator" Width="8" Height="8" Fill="{StaticResource MeasurementAccentBrush}" Visibility="Collapsed" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="0">
                            <TextBlock Text="RF" />
                            <TextBlock Text="Measurements" FontSize="10" />
                        </StackPanel>
                    </Grid>
                </Button>
            </StackPanel>
        </Border>

        <Grid x:Name="ReceiverWorkspaceMain" Grid.Row="2" Margin="140,10,10,10" ColumnSpacing="10" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="175" MinWidth="150" />
                <ColumnDefinition Width="*" MinWidth="350" />
                <ColumnDefinition Width="175" MinWidth="160" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelCardStyle}" Padding="14">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="ENSEMBLES" Style="{StaticResource SectionTitleStyle}" />
                    <Border Grid.Row="1" Padding="10" CornerRadius="6" Background="#2535D0BA" BorderBrush="{StaticResource MeasurementAccentBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="EnsembleNameText" Text="Awaiting FIC ensemble" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="EnsembleDetailText" Text="Tune and start the receiver" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,2,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="SERVICES" Style="{StaticResource SectionTitleStyle}" />
                        <ListView x:Name="ServicesListView"
                                  Grid.Row="1"
                                  SelectionMode="Single"
                                  IsItemClickEnabled="True"
                                  ItemClick="ServicesListView_ItemClick"
                                  SelectionChanged="ServicesListView_SelectionChanged">
                            <ListViewItem Content="Awaiting decoded services..." IsEnabled="False" />
                        </ListView>
                    </Grid>

                    <Rectangle Grid.Row="3" Height="1" Fill="{StaticResource PanelStrokeBrush}" />
                    <TextBlock Grid.Row="4" Text="COMPONENTS" Style="{StaticResource SectionTitleStyle}" />
                    <ListView x:Name="ComponentsListView" Grid.Row="5" SelectionMode="None" MaxHeight="180">
                        <ListViewItem Content="Select a decoded service" IsEnabled="False" />
                    </ListView>

                </Grid>
            </Border>

            <Grid Grid.Column="1" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="210" />
                    <RowDefinition Height="2*" MinHeight="140" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="14,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="SPECTRUM / WATERFALL" Style="{StaticResource SectionTitleStyle}" />
                                <Border Padding="8,2" CornerRadius="10" Background="#2235D0BA">
                                    <TextBlock x:Name="SampleRateText" Text="2.048 MS/s" Foreground="{StaticResource MeasurementAccentBrush}" FontSize="10" />
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="RBW 1 kHz" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            <TextBlock Grid.Column="2" x:Name="SampleCounterText" Text="frame 000000" VerticalAlignment="Center" FontFamily="Consolas" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                        </Grid>

                        <Border Grid.Row="1" Margin="10,0,10,4" Background="#FF07101B" CornerRadius="4" BorderBrush="#FF203249" BorderThickness="1">
                            <Viewbox Stretch="Fill">
                                <Canvas Width="900" Height="260">
                                    <Line X1="0" Y1="52" X2="900" Y2="52" Stroke="#253D556E" StrokeThickness="1" />
                                    <Line X1="0" Y1="104" X2="900" Y2="104" Stroke="#253D556E" StrokeThickness="1" />
                                    <Line X1="0" Y1="156" X2="900" Y2="156" Stroke="#253D556E" StrokeThickness="1" />
                                    <Line X1="0" Y1="208" X2="900" Y2="208" Stroke="#253D556E" StrokeThickness="1" />
                                    <Line X1="180" Y1="0" X2="180" Y2="260" Stroke="#253D556E" StrokeThickness="1" />
                                    <Line X1="360" Y1="0" X2="360" Y2="260" Stroke="#253D556E" StrokeThickness="1" />
                                    <Line X1="540" Y1="0" X2="540" Y2="260" Stroke="#253D556E" StrokeThickness="1" />
                                    <Line X1="720" Y1="0" X2="720" Y2="260" Stroke="#253D556E" StrokeThickness="1" />
                                    <Rectangle Canvas.Left="110" Canvas.Top="14" Width="680" Height="226" Fill="#0B35D0BA" Stroke="#4035D0BA" StrokeThickness="1" />
                                    <Polyline x:Name="SpectrumTrace"
                                              Stroke="{StaticResource SpectrumBrush}"
                                              StrokeThickness="2"
                                              Points="0,240 900,240" />
                                    <Line X1="450" Y1="8" X2="450" Y2="250" Stroke="{StaticResource WarningBrush}" StrokeThickness="1" StrokeDashArray="4,4" />
                                    <TextBlock Canvas.Left="458" Canvas.Top="12" x:Name="SpectrumFrequencyText" Text="213.360 MHz" Foreground="{StaticResource WarningBrush}" FontFamily="Consolas" FontSize="11" />
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <Border Grid.Row="2" Margin="10,0,10,10" CornerRadius="4" BorderBrush="#FF203249" BorderThickness="1">
                            <Viewbox Stretch="Fill">
                                <Canvas x:Name="WaterfallCanvas" Width="900" Height="125" Background="#FF07101B" />
                            </Viewbox>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}">
                    <TabView IsAddTabButtonVisible="False" TabWidthMode="Equal">
                        <TabViewItem Header="Constellation" IsClosable="False">
                            <Grid Margin="10">
                                <Viewbox Stretch="Uniform">
                                    <Canvas x:Name="ConstellationCanvas" Width="520" Height="220" Background="#FF07101B">
                                        <Line X1="260" Y1="10" X2="260" Y2="210" Stroke="#334B6178" StrokeThickness="1" />
                                        <Line X1="10" Y1="110" X2="510" Y2="110" Stroke="#334B6178" StrokeThickness="1" />
                                        <Ellipse Canvas.Left="126" Canvas.Top="50" Width="7" Height="7" Fill="#FF54E2FF" />
                                        <Ellipse Canvas.Left="388" Canvas.Top="50" Width="7" Height="7" Fill="#FF54E2FF" />
                                        <Ellipse Canvas.Left="126" Canvas.Top="166" Width="7" Height="7" Fill="#FF54E2FF" />
                                        <Ellipse Canvas.Left="388" Canvas.Top="166" Width="7" Height="7" Fill="#FF54E2FF" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </TabViewItem>
                        <TabViewItem Header="CIR" IsClosable="False">
                            <Viewbox Margin="10" Stretch="Fill">
                                <Canvas Width="800" Height="210" Background="#FF07101B">
                                    <Line X1="0" Y1="170" X2="800" Y2="170" Stroke="#334B6178" />
                                    <Polyline x:Name="CirTrace" Stroke="{StaticResource MeasurementAccentBrush}" StrokeThickness="2" Points="0,180 800,180" />
                                    <TextBlock x:Name="CirStatusText" Canvas.Left="12" Canvas.Top="12" Text="awaiting channel estimate" Foreground="{StaticResource MeasurementAccentBrush}" FontSize="11" />
                                </Canvas>
                            </Viewbox>
                        </TabViewItem>
                        <TabViewItem Header="Carrier MER" IsClosable="False">
                            <Grid Margin="14" RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Viewbox Stretch="Fill">
                                    <Canvas Width="800" Height="190" Background="#FF07101B">
                                        <Polyline x:Name="CarrierMerTrace" Stroke="{StaticResource MeasurementAccentBrush}" StrokeThickness="2" Points="0,130 800,130" />
                                        <Line X1="0" Y1="130" X2="800" Y2="130" Stroke="{StaticResource WarningBrush}" StrokeDashArray="4,4" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Row="1" x:Name="CarrierMerStatusText" Text="Carrier index −768 … +768 · awaiting MER" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            </Grid>
                        </TabViewItem>
                    </TabView>
                </Border>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="LIVE KPIs" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                            <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{StaticResource MeasurementAccentBrush}" />
                        </Grid>

                        <Border Padding="10,6" CornerRadius="6" Background="{StaticResource PanelRaisedBrush}">
                            <StackPanel>
                                <TextBlock Text="RF INPUT" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <TextBlock x:Name="RfSummaryPowerText" Text="— dBFS" Style="{StaticResource KpiValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Padding="10,6" CornerRadius="6" Background="{StaticResource PanelRaisedBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="MER" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    <TextBlock x:Name="MerValueText" Text="— dB" Style="{StaticResource KpiValueStyle}" />
                                </StackPanel>
                                <FontIcon Grid.Column="1" Glyph="&#xE9D2;" Foreground="{StaticResource MeasurementAccentBrush}" />
                            </Grid>
                        </Border>
                        <Border Padding="10,6" CornerRadius="6" Background="{StaticResource PanelRaisedBrush}">
                            <StackPanel>
                                <TextBlock Text="SNR" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <TextBlock x:Name="SnrValueText" Text="— dB" Style="{StaticResource KpiValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Padding="10,6" CornerRadius="6" Background="{StaticResource PanelRaisedBrush}">
                            <StackPanel>
                                <TextBlock Text="CFO" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <TextBlock x:Name="CfoValueText" Text="— Hz" Style="{StaticResource KpiValueStyle}" />
                            </StackPanel>
                        </Border>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Padding="8,6" CornerRadius="6" Background="{StaticResource PanelRaisedBrush}">
                                <StackPanel>
                                    <TextBlock Text="BER proxy" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                    <TextBlock x:Name="BerValueText" Text="—" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Padding="8,6" CornerRadius="6" Background="{StaticResource PanelRaisedBrush}">
                                <StackPanel>
                                    <TextBlock Text="FIB CRC" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                    <TextBlock x:Name="CrcValueText" Text="— / —" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Rectangle Height="1" Fill="{StaticResource PanelStrokeBrush}" Margin="0,2" />
                        <TextBlock Text="RECEIVER DETAIL" Style="{StaticResource SectionTitleStyle}" />
                        <Grid RowSpacing="7" ColumnSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ADC level" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Grid.Column="1" x:Name="AdcValueText" Text="— dBFS" FontFamily="Consolas" />
                            <TextBlock Grid.Row="1" Text="PRS score" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PrsValueText" Text="—" FontFamily="Consolas" />
                            <TextBlock Grid.Row="2" Text="Spectrum C/N" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CnValueText" Text="— dB" FontFamily="Consolas" />
                            <TextBlock Grid.Row="3" Text="Timing error" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TimingValueText" Text="— samples" FontFamily="Consolas" />
                            <TextBlock Grid.Row="4" Text="Dropped blocks" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DropValueText" Text="0" FontFamily="Consolas" />
                        </Grid>
                        <ProgressBar x:Name="FicProgress" Minimum="0" Maximum="1" Value="0" Height="4" Foreground="{StaticResource MeasurementAccentBrush}" />
                        <Button x:Name="OpenRfButton"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Click="RfMeasurements_Click"
                                Content="Open RF Measurements  →" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border x:Name="ReceiverTimelinePanel" Grid.Row="3" Margin="140,0,10,10" Style="{StaticResource PanelCardStyle}" HorizontalAlignment="Left">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="14,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="TIMELINE · EVENTS · ALARMS · ANNOTATIONS" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                    <Line Grid.Column="1" X1="0" Y1="20" X2="1000" Y2="20" Stretch="Fill" Stroke="{StaticResource PanelStrokeBrush}" StrokeThickness="1" />
                    <TextBlock Grid.Column="2" Text="last 60 s" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" FontSize="11" />
                </Grid>
                <ListView Grid.Row="1" x:Name="TimelineList" SelectionMode="None" Padding="8,0" IsItemClickEnabled="False">
                    <ListViewItem Content="00:00.000  ·  Ready — select a device and start the receiver" />
                    <ListViewItem Content="00:00.000  ·  Snapshot mailbox initialized" />
                </ListView>
            </Grid>
        </Border>

        <Grid x:Name="RfWorkspace"
              Grid.Row="2"
              Grid.RowSpan="2"
              Margin="140,10,10,10"
              HorizontalAlignment="Left"
              SizeChanged="RfWorkspace_SizeChanged"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PanelCardStyle}" Padding="18,13" Margin="0,0,0,10">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3" MaxWidth="420">
                        <TextBlock Text="RF Measurements" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock x:Name="RfContextText"
