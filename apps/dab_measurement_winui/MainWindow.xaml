                                        <TextBlock x:Name="RfSpectrumAxisCenterText" Text="213.360 MHz" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="RfSpectrumAxisRightText" Text="214.384 MHz" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource PanelCardStyle}" Padding="12,10">
                                <Grid RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="150" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Waterfall" FontSize="15" FontWeight="SemiBold" />
                                    <Border Grid.Row="1" BorderBrush="{StaticResource PanelStrokeBrush}" BorderThickness="1" Background="#FF07101B">
                                        <Viewbox Stretch="Fill">
                                            <Canvas x:Name="RfSpectrumWaterfallCanvas" Width="1000" Height="150" Background="#FF07101B" />
                                        </Viewbox>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource PanelCardStyle}" Padding="12,8">
                                <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="RfSpectrumMarkerStatusText"
                                               Text="Marker 1: click the spectrum to place"
                                               FontFamily="Consolas"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               x:Name="RfSpectrumNoiseFloorText"
                                               Text="Noise floor: — dBFS"
                                               FontFamily="Consolas"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>
                <TabViewItem Header="RF Input" IsClosable="False">
                    <TextBlock Text="RF input controls and calibration will be added here." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                </TabViewItem>
                <TabViewItem Header="Frequency &amp; Sync" IsClosable="False">
                    <TextBlock Text="Frequency and synchronization diagnostics will be added here." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                </TabViewItem>
                <TabViewItem Header="Channel/CIR" IsClosable="False">
                    <TextBlock Text="Channel impulse response analysis will be added here." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                </TabViewItem>
                <TabViewItem Header="History" IsClosable="False">
                    <TextBlock Text="Long-term RF history and export will be added here." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                </TabViewItem>
            </TabView>
        </Grid>

        <Border Grid.Row="4" Background="#FF0B1522" BorderBrush="{StaticResource PanelStrokeBrush}" BorderThickness="0,1,0,0" Padding="12,0">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusDeviceText" Text="SDRplay RSP1A" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="StatusChannelText" Text="10C" VerticalAlignment="Center" Foreground="{StaticResource SpectrumBrush}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource MeasurementAccentBrush}" />
                    <TextBlock x:Name="StatusSyncText" Text="idle" />
                </StackPanel>
                <TextBlock Grid.Column="3" x:Name="StatusRecordText" Text="not recording" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Grid.Column="4" x:Name="StatusCalibrationText" Text="Uncalibrated" VerticalAlignment="Center" Foreground="{StaticResource WarningBrush}" />
                <TextBlock Grid.Column="5" x:Name="StatusOverrunText" Text="no overruns" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Grid.Column="7" x:Name="StatusCpuText" Text="CPU —" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" />
            </Grid>
        </Border>
    </Grid>
</Window>
