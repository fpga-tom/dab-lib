<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DabMeasurementWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DabMeasurementWinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Closed="Window_Closed"
    Title="DAB+ Measurement Workbench">

    <Grid x:Name="RootLayout"
          Background="{StaticResource WorkspaceBrush}"
          RequestedTheme="Dark"
          SizeChanged="RootLayout_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="156" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0" Background="{StaticResource PanelBrush}">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="New measurement" />
                <MenuFlyoutItem Text="Open session..." />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Export snapshot..." />
            </MenuBarItem>
            <MenuBarItem Title="Receiver">
                <MenuFlyoutItem Text="Device setup..." />
                <MenuFlyoutItem Text="Band III channel plan" />
            </MenuBarItem>
            <MenuBarItem Title="Measurement">
                <MenuFlyoutItem Text="New measurement profile..." />
                <MenuFlyoutItem Text="Alarm thresholds..." />
            </MenuBarItem>
            <MenuBarItem Title="View">
                <MenuFlyoutItem Text="Receiver workspace" Click="ReceiverWorkspace_Click" />
                <MenuFlyoutItem Text="RF Measurements" Click="RfMeasurements_Click" />
                <MenuFlyoutItem Text="DAB Measurements" Click="DabMeasurements_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Spectrum and waterfall" />
                <MenuFlyoutItem Text="Constellation" />
                <MenuFlyoutItem Text="Timeline" />
            </MenuBarItem>
            <MenuBarItem Title="Tools">
                <MenuFlyoutItem Text="Device diagnostics" />
                <MenuFlyoutItem Text="Recording browser" />
            </MenuBarItem>
            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="About DAB+ Measurement Workbench" />
            </MenuBarItem>
        </MenuBar>

        <Border Grid.Row="1"
                Padding="12,8"
                Background="{StaticResource PanelRaisedBrush}"
                BorderBrush="{StaticResource PanelStrokeBrush}"
                BorderThickness="0,1,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <Grid MinWidth="950" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="145" />
                        <ColumnDefinition Width="75" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="75" />
                        <ColumnDefinition Width="85" />
                        <ColumnDefinition Width="85" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" x:Name="DeviceComboBox" Header="DEVICE" SelectedIndex="0">
                        <ComboBoxItem Content="SDRplay RSP1A" />
                        <ComboBoxItem Content="RTL-SDR" />
                    </ComboBox>
                    <ComboBox Grid.Column="1"
                              x:Name="ChannelComboBox"
                              Header="CHANNEL"
                              SelectedIndex="22"
                              SelectionChanged="ChannelComboBox_SelectionChanged">
                        <ComboBoxItem Content="5A" Tag="174.928" />
                        <ComboBoxItem Content="5B" Tag="176.640" />
                        <ComboBoxItem Content="5C" Tag="178.352" />
                        <ComboBoxItem Content="5D" Tag="180.064" />
                        <ComboBoxItem Content="6A" Tag="181.936" />
                        <ComboBoxItem Content="6B" Tag="183.648" />
                        <ComboBoxItem Content="6C" Tag="185.360" />
                        <ComboBoxItem Content="6D" Tag="187.072" />
                        <ComboBoxItem Content="7A" Tag="188.928" />
                        <ComboBoxItem Content="7B" Tag="190.640" />
                        <ComboBoxItem Content="7C" Tag="192.352" />
                        <ComboBoxItem Content="7D" Tag="194.064" />
                        <ComboBoxItem Content="8A" Tag="195.936" />
                        <ComboBoxItem Content="8B" Tag="197.648" />
                        <ComboBoxItem Content="8C" Tag="199.360" />
                        <ComboBoxItem Content="8D" Tag="201.072" />
                        <ComboBoxItem Content="9A" Tag="202.928" />
                        <ComboBoxItem Content="9B" Tag="204.640" />
                        <ComboBoxItem Content="9C" Tag="206.352" />
                        <ComboBoxItem Content="9D" Tag="208.064" />
                        <ComboBoxItem Content="10A" Tag="209.936" />
                        <ComboBoxItem Content="10B" Tag="211.648" />
                        <ComboBoxItem Content="10C" Tag="213.360" />
                        <ComboBoxItem Content="10D" Tag="215.072" />
                        <ComboBoxItem Content="11A" Tag="216.928" />
                        <ComboBoxItem Content="11B" Tag="218.640" />
                        <ComboBoxItem Content="11C" Tag="220.352" />
                        <ComboBoxItem Content="11D" Tag="222.064" />
                        <ComboBoxItem Content="12A" Tag="223.936" />
                        <ComboBoxItem Content="12B" Tag="225.648" />
                        <ComboBoxItem Content="12C" Tag="227.360" />
                        <ComboBoxItem Content="12D" Tag="229.072" />
                        <ComboBoxItem Content="13A" Tag="230.784" />
                        <ComboBoxItem Content="13B" Tag="232.496" />
                        <ComboBoxItem Content="13C" Tag="234.208" />
                        <ComboBoxItem Content="13D" Tag="235.776" />
                        <ComboBoxItem Content="13E" Tag="237.488" />
                        <ComboBoxItem Content="13F" Tag="239.200" />
                    </ComboBox>
                    <TextBox Grid.Column="2" x:Name="FrequencyTextBox" Header="FREQUENCY" Text="213.360 MHz" />
                    <NumberBox Grid.Column="3" x:Name="GainNumberBox" Header="GAIN" Value="40" SpinButtonPlacementMode="Compact" />

                    <Button Grid.Column="4"
                            x:Name="StartButton"
                            Height="34"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch"
                            Click="StartButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock x:Name="StartButtonLabel" Text="Start" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="5"
                            x:Name="RecordButton"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Recording will be added after the live receiver path is validated"
                            Height="34"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch"
                            Click="RecordButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7C8;" FontSize="14" />
                            <TextBlock x:Name="RecordButtonLabel" Text="Record" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="6"
                            x:Name="RfToolbarButton"
                            Height="34"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch"
                            Click="RfMeasurements_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="RF" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="7"
                            x:Name="DabToolbarButton"
                            Height="34"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch"
                            Click="DabMeasurements_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="DAB" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="8"
                            Height="34"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch"
                            Click="AudioButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Audio" />
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="9" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Padding="10,4" CornerRadius="12" Background="#2935D0BA">
                            <TextBlock x:Name="DataModeText" Text="LIVE METRICS" Foreground="{StaticResource MeasurementAccentBrush}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock x:Name="DataSeamText" Text="receiver stopped" Margin="0,4,0,0" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <Border x:Name="WorkspaceNavigationPanel"
                Grid.Row="2"
                Grid.RowSpan="2"
                Width="120"
                Margin="10"
                HorizontalAlignment="Left"
                Style="{StaticResource PanelCardStyle}"
                Padding="10">
            <StackPanel Spacing="8">
                <TextBlock Text="WORKSPACES" Style="{StaticResource SectionTitleStyle}" Margin="6,4,0,6" />
                <Button x:Name="ReceiverNavigationButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Click="ReceiverWorkspace_Click">
                    <Grid ColumnSpacing="9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="ReceiverNavIndicator" Width="8" Height="8" Fill="{StaticResource MeasurementAccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Receiver" />
                    </Grid>
                </Button>
                <Button x:Name="RfNavigationButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Click="RfMeasurements_Click">
                    <Grid ColumnSpacing="9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="RfNavIndicator" Width="8" Height="8" Fill="{StaticResource MeasurementAccentBrush}" Visibility="Collapsed" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="0">
                            <TextBlock Text="RF" />
                            <TextBlock Text="Measurements" FontSize="10" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Button x:Name="DabNavigationButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Click="DabMeasurements_Click">
                    <Grid ColumnSpacing="9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="DabNavIndicator" Width="8" Height="8" Fill="{StaticResource MeasurementAccentBrush}" Visibility="Collapsed" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="0">
                            <TextBlock Text="DAB" />
                            <TextBlock Text="Measurements" FontSize="10" />
                        </StackPanel>
                    </Grid>
                </Button>
            </StackPanel>
        </Border>

        <Grid x:Name="ReceiverWorkspaceMain" Grid.Row="2" Margin="140,10,10,10" ColumnSpacing="10" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="175" MinWidth="150" />
                <ColumnDefinition Width="*" MinWidth="350" />
                <ColumnDefinition Width="175" MinWidth="160" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ReceiverCatalogPanel" Grid.Column="0" Style="{StaticResource PanelCardStyle}" Padding="14">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="ENSEMBLES" Style="{StaticResource SectionTitleStyle}" />
                    <Border Grid.Row="1" Padding="10" CornerRadius="6" Background="#2535D0BA" BorderBrush="{StaticResource MeasurementAccentBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="EnsembleNameText" Text="Awaiting FIC ensemble" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="EnsembleDetailText" Text="Tune and start the receiver" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,2,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="SERVICES" Style="{StaticResource SectionTitleStyle}" />
                        <ListView x:Name="ServicesListView"
                                  Grid.Row="1"
                                  SelectionMode="Single"
                                  IsItemClickEnabled="True"
                                  ItemClick="ServicesListView_ItemClick"
                                  SelectionChanged="ServicesListView_SelectionChanged">
                            <ListViewItem Content="Awaiting decoded services..." IsEnabled="False" />
                        </ListView>
                    </Grid>

                    <Rectangle Grid.Row="3" Height="1" Fill="{StaticResource PanelStrokeBrush}" />
                    <TextBlock Grid.Row="4" Text="COMPONENTS" Style="{StaticResource SectionTitleStyle}" />
                    <ListView x:Name="ComponentsListView" Grid.Row="5" SelectionMode="None" MaxHeight="180">
                        <ListViewItem Content="Select a decoded service" IsEnabled="False" />
                    </ListView>

                </Grid>
            </Border>

            <Grid x:Name="ReceiverCenterGrid" Grid.Column="1" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="210" />
                    <RowDefinition Height="2*" MinHeight="140" />
                </Grid.RowDefinitions>

                <Border x:Name="ReceiverSpectrumPanel" Grid.Row="0" Style="{StaticResource PanelCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="14,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="SPECTRUM / WATERFALL" Style="{StaticResource SectionTitleStyle}" />
                                <Border Padding="8,2" CornerRadius="10" Background="#2235D0BA">
                                    <TextBlock x:Name="SampleRateText" Text="2.048 MS/s" Foreground="{StaticResource MeasurementAccentBrush}" FontSize="10" />
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="RBW 1 kHz" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            <TextBlock Grid.Column="2" x:Name="SampleCounterText" Text="frame 000000" VerticalAlignment="Center" FontFamily="Consolas" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                        </Grid>

                        <Border Grid.Row="1" Margin="10,0,10,4" Background="#FF07101B" CornerRadius="4" BorderBrush="#FF203249" BorderThickness="1">
                            <Viewbox Stretch="Fill">
                                <Canvas Width="900" Height="260">
                                    <Line X1="0" Y1="52" X2="900" Y2="52" Stroke="#253D556E" StrokeThickness="1" />
                                    <Line X1="0" Y1="104" X2="900" Y2="104" Stroke="#253D556E" StrokeThickness="1" />
                                    <Line X1="0" Y1="156" X2="900" Y2="156" Stroke="#253D556E" StrokeThickness="1" />
                                    <Line X1="0" Y1="208" X2="900" Y2="208" Stroke="#253D556E" StrokeThickness="1" />
                                    <Line X1="180" Y1="0" X2="180" Y2="260" Stroke="#253D556E" StrokeThickness="1" />
                                    <Line X1="360" Y1="0" X2="360" Y2="260" Stroke="#253D556E" StrokeThickness="1" />
                                    <Line X1="540" Y1="0" X2="540" Y2="260" Stroke="#253D556E" StrokeThickness="1" />
                                    <Line X1="720" Y1="0" X2="720" Y2="260" Stroke="#253D556E" StrokeThickness="1" />
                                    <Rectangle Canvas.Left="110" Canvas.Top="14" Width="680" Height="226" Fill="#0B35D0BA" Stroke="#4035D0BA" StrokeThickness="1" />
                                    <Polyline x:Name="SpectrumTrace"
                                              Stroke="{StaticResource SpectrumBrush}"
                                              StrokeThickness="2"
                                              Points="0,240 900,240" />
                                    <Line X1="450" Y1="8" X2="450" Y2="250" Stroke="{StaticResource WarningBrush}" StrokeThickness="1" StrokeDashArray="4,4" />
                                    <TextBlock Canvas.Left="458" Canvas.Top="12" x:Name="SpectrumFrequencyText" Text="213.360 MHz" Foreground="{StaticResource WarningBrush}" FontFamily="Consolas" FontSize="11" />
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <Border Grid.Row="2" Margin="10,0,10,10" CornerRadius="4" BorderBrush="#FF203249" BorderThickness="1">
                            <Viewbox Stretch="Fill">
                                <Canvas x:Name="WaterfallCanvas" Width="900" Height="125" Background="#FF07101B" />
                            </Viewbox>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="ReceiverAnalysisPanel" Grid.Row="1" Style="{StaticResource PanelCardStyle}">
                    <TabView IsAddTabButtonVisible="False" TabWidthMode="Equal">
                        <TabView.TabStripFooter>
                            <Button x:Name="CirExpandButton"
                                    Width="34"
                                    Height="30"
                                    Margin="4,2,8,2"
                                    Padding="0"
                                    ToolTipService.ToolTip="Maximize analysis panel"
                                    AutomationProperties.Name="Maximize analysis panel"
                                    Click="CirExpandButton_Click">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="M" Modifiers="Control" />
                                </Button.KeyboardAccelerators>
                                <FontIcon x:Name="CirExpandIcon" Glyph="&#xE740;" FontSize="13" />
                            </Button>
                        </TabView.TabStripFooter>
                        <TabViewItem Header="Constellation" IsClosable="False">
                            <Grid Margin="10" RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Viewbox Stretch="Uniform">
                                    <Canvas x:Name="ConstellationCanvas" Width="280" Height="280" Background="#FF07101B">
                                        <Rectangle Canvas.Left="30" Canvas.Top="20" Width="230" Height="230" Fill="#FF07101B" Stroke="#334B6178" StrokeThickness="1" />
                                        <Line X1="49.17" Y1="20" X2="49.17" Y2="250" Stroke="#183D556E" StrokeThickness="1" />
                                        <Line X1="240.83" Y1="20" X2="240.83" Y2="250" Stroke="#183D556E" StrokeThickness="1" />
                                        <Line X1="30" Y1="39.17" X2="260" Y2="39.17" Stroke="#183D556E" StrokeThickness="1" />
                                        <Line X1="30" Y1="230.83" X2="260" Y2="230.83" Stroke="#183D556E" StrokeThickness="1" />
                                        <Line X1="145" Y1="20" X2="145" Y2="250" Stroke="#665A718A" StrokeThickness="1" />
                                        <Line X1="30" Y1="135" X2="260" Y2="135" Stroke="#665A718A" StrokeThickness="1" />

                                        <TextBlock Canvas.Left="42" Canvas.Top="252" Text="−1" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Canvas.Left="142" Canvas.Top="252" Text="0" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Canvas.Left="233" Canvas.Top="252" Text="+1" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Canvas.Left="4" Canvas.Top="31" Text="+1" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Canvas.Left="14" Canvas.Top="127" Text="0" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Canvas.Left="4" Canvas.Top="222" Text="−1" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Canvas.Left="264" Canvas.Top="126" Text="I" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MeasurementAccentBrush}" />
                                        <TextBlock Canvas.Left="150" Canvas.Top="1" Text="Q" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MeasurementAccentBrush}" />

                                        <Ellipse Canvas.Left="72.24" Canvas.Top="62.24" Width="10" Height="10" Fill="Transparent" Stroke="{StaticResource WarningBrush}" StrokeThickness="1.5" />
                                        <Ellipse Canvas.Left="207.76" Canvas.Top="62.24" Width="10" Height="10" Fill="Transparent" Stroke="{StaticResource WarningBrush}" StrokeThickness="1.5" />
                                        <Ellipse Canvas.Left="72.24" Canvas.Top="197.76" Width="10" Height="10" Fill="Transparent" Stroke="{StaticResource WarningBrush}" StrokeThickness="1.5" />
                                        <Ellipse Canvas.Left="207.76" Canvas.Top="197.76" Width="10" Height="10" Fill="Transparent" Stroke="{StaticResource WarningBrush}" StrokeThickness="1.5" />
                                        <Canvas x:Name="ConstellationPointCanvas" Width="280" Height="280" IsHitTestVisible="False" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Row="1"
                                           Text="Normalized I/Q · equal axes −1.2 … +1.2 · ideal QPSK targets ±0.707"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           HorizontalAlignment="Center" />
                            </Grid>
                        </TabViewItem>
                        <TabViewItem Header="CIR" IsClosable="False">
                            <Grid Margin="10" RowSpacing="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Viewbox Stretch="Fill">
                                    <Canvas x:Name="CirCanvas" Width="900" Height="240" Background="#FF07101B">
                                        <Line X1="58" Y1="34" X2="878" Y2="34" Stroke="#334B6178" />
                                        <Line X1="58" Y1="89.33" X2="878" Y2="89.33" Stroke="#253D556E" />
                                        <Line X1="58" Y1="144.67" X2="878" Y2="144.67" Stroke="#253D556E" />
                                        <Line X1="58" Y1="200" X2="878" Y2="200" Stroke="#334B6178" />
                                        <Line X1="58" Y1="34" X2="58" Y2="200" Stroke="#334B6178" />
                                        <Line X1="263" Y1="34" X2="263" Y2="200" Stroke="#183D556E" />
                                        <Line X1="468" Y1="34" X2="468" Y2="200" Stroke="#183D556E" />
                                        <Line X1="673" Y1="34" X2="673" Y2="200" Stroke="#183D556E" />
                                        <Line X1="878" Y1="34" X2="878" Y2="200" Stroke="#334B6178" />

                                        <TextBlock Canvas.Left="10" Canvas.Top="26" Text="0 dB" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Canvas.Left="4" Canvas.Top="81" Text="−20 dB" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Canvas.Left="4" Canvas.Top="137" Text="−40 dB" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Canvas.Left="4" Canvas.Top="192" Text="−60 dB" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Canvas.Left="52" Canvas.Top="202" Text="0" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Canvas.Left="246" Canvas.Top="202" Text="62.5" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Canvas.Left="454" Canvas.Top="202" Text="125" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Canvas.Left="654" Canvas.Top="202" Text="187.5" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Canvas.Left="862" Canvas.Top="202" Text="250" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Canvas.Left="410" Canvas.Top="222" Text="Delay relative to FFT timing (µs)" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />

                                        <Polyline x:Name="CirTrace"
                                                  Stroke="{StaticResource MeasurementAccentBrush}"
                                                  StrokeThickness="1.7"
                                                  Points="58,200 878,200" />
                                        <Canvas x:Name="CirMarkerCanvas" Width="900" Height="240" IsHitTestVisible="False" />
                                        <TextBlock x:Name="CirStatusText"
                                                   Canvas.Left="58"
                                                   Canvas.Top="8"
                                                   Text="Awaiting channel estimate"
                                                   Foreground="{StaticResource MeasurementAccentBrush}"
                                                   FontFamily="Consolas"
                                                   FontSize="11" />
                                        <TextBlock x:Name="CirPathSummaryText"
                                                   Canvas.Left="580"
                                                   Canvas.Top="8"
                                                   Width="298"
                                                   Text="No paths detected"
                                                   TextAlignment="Right"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontFamily="Consolas"
                                                   FontSize="11" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Row="1"
                                           x:Name="CirDetectedPathsText"
                                           Text="Detected paths: awaiting channel estimate"
                                           Foreground="{StaticResource MeasurementAccentBrush}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="2"
                                           Text="Hann-windowed channel estimate · 8-frame linear-power average · levels relative to strongest tap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11"
